import { Ref } from 'vue';
{{~ if OptionsInfo.size > 0 ~}}

{{~ for option in OptionsInfo4DS ~}}
import { {{ option.GetDdlDataFuncName }} } from '@/ts/{{ option.WApiPath }}/{{ option.ModuleName }}/{{ option.WApiFileName }}';
{{~ end ~}}
{{~ 
  # 🔥 收集需要导入的共享变量
  shared_vars = []
  for option in OptionsInfo4DS
    if option.Parameters.size > 0
      for param in option.Parameters
        if !(shared_vars | array.contains param.SharedVarName)
          shared_vars = shared_vars | array.add param.SharedVarName
        end
      end
    end
  end
~}}
{{~ if shared_vars.size > 0 ~}}
import {
  {{~ for var in shared_vars ~}}
  {{ var }}{{ if !for.last }},{{ end }}
  {{~ end ~}}
} from '@/views/{{ ModuleName }}/{{ TableName }}VueShare';
{{~ end ~}}
{{~ end ~}}

import { QueryControlType } from '@/viewsBase/common/TableSpecQuery';

/** Ai 查询字段键定义。 */
export type {{ TableName }}QueryFieldKeyAi =
{{~ for field in QueryFields ~}}
  | '{{ field.Key }}'{{ if !for.last }}{{ end }}
{{~ end ~}};

export interface {{ TableName }}QueryFieldSpecAi {
  key: {{ TableName }}QueryFieldKeyAi;
  label: string;
  id: string;
  controlType: QueryControlType;
  width: number;
  row: number;
  order: number;
  visibleInQuery?: boolean;  
{{~ if OptionsInfo.size > 0 ~}}
    optionsKey?: {{~ for option in OptionsInfo ~}}'{{ option.Key }}'{{ if !for.last }} | {{ end }}{{~ end ~}};
{{~ else ~}}
    optionsKey?: string; // 如果 controlType 需要选项，则指定 optionsKey 来获取选项数据
{{~ end ~}}
}

export const {{ TableName | string.upcase | string.replace "DATABASE" "_DATABASE" }}_QUERY_SPECS_AI: Array<{{ TableName }}QueryFieldSpecAi> = [
{{~ for field in QueryFields ~}}
  {
    key: '{{ field.Key }}',
    label: '{{ field.Label }}',
    id: '{{ field.Id }}',
    controlType: '{{ field.ControlType }}',
    width: {{ field.Width }},
    row: {{ field.Row }},
    order: {{ field.Order }},
    {{~ if field.ControlType == 'select' ~}}
        optionsKey: '{{ field.OptionsKey }}',
    {{~ end ~}}
    {{~ if field.ControlType == 'select4Bool' ~}}
        optionsKey: '{{ field.OptionsKey }}',
    {{~ end ~}}

  }{{ if !for.last }},{{ end }}
{{~ end ~}}
];

export function initQueryDefaultsAi(queryRefs: {
{{~ for field in QueryFields ~}}
    {{ field.Key }}: Ref<string>;
{{~ end ~}}
}) {
{{~ for field in QueryFields ~}}
   {{~ if field.ControlType == 'select4Bool' ~}}
        queryRefs.{{ field.Key }}.value = '0';
   {{~ else ~}}
        queryRefs.{{ field.Key }}.value = '{{ field.DefaultValue }}';
   {{~ end ~}}
{{~ end ~}}
}

export async function loadQueryOptionsAi() {
{{~ if OptionsInfo4DS.size > 0 ~}}
  const [{{~ for option in OptionsInfo4DS ~}}arr{{ option.WApiClass }}{{ if !for.last }}, {{ end }}{{~ end ~}}] = await Promise.all([
{{~ for option in OptionsInfo4DS ~}}
    {{ option.GetDdlDataFuncName }}({{~ 
      if option.Parameters.size > 0 
        for param in option.Parameters 
          ~}}{{ param.SharedVarName }}.value{{~ if !for.last ~}}, {{~ end ~}}{{~ 
        end 
      end 
    ~}}){{ if !for.last }},{{ end }}
{{~ end ~}}
  ]);
  return { {{~ for option in OptionsInfo4DS ~}}arr{{ option.WApiClass }}{{ if !for.last }}, {{ end }}{{~ end ~}} };
{{~ else ~}}
  return {};
{{~ end ~}}
}

export async function loadFeatureOptionsAi() {
{{~ 
  feature_options = []
  for option in OptionsInfo
    if option.Key == "useState"
      feature_options = feature_options | array.add option
    end
  end
~}}
{{~ if feature_options.size > 0 ~}}
  const arr{{ feature_options[0].WApiClass }} = await {{ feature_options[0].GetDdlDataFuncName }}({{~ 
    if feature_options[0].Parameters.size > 0 
      for param in feature_options[0].Parameters 
        ~}}{{ param.SharedVarName }}.value{{~ if !for.last ~}}, {{~ end ~}}{{~ 
      end 
    end 
  ~}});
  return { arr{{ feature_options[0].WApiClass }} };
{{~ else ~}}
  return {};
{{~ end ~}}
}

export function getQueryRowsAi() {
  const row1 = {{ TableName | string.upcase | string.replace "DATABASE" "_DATABASE" }}_QUERY_SPECS_AI.filter(
    (x) => x.row === 1 && x.visibleInQuery !== false,
  ).sort((a, b) => a.order - b.order);
  const row2 = {{ TableName | string.upcase | string.replace "DATABASE" "_DATABASE" }}_QUERY_SPECS_AI.filter(
    (x) => x.row === 2 && x.visibleInQuery !== false,
  ).sort((a, b) => a.order - b.order);
  return { row1, row2 };
}