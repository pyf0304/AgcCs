import { {{ TableName }}_DetailAi } from '@/viewsBase/{{ ModuleName }}/{{ TableName }}_DetailAi';
import { {{ TableName }}Key } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}EN';

/* {{ TableName }}_DetailEx 的摘要说明。其中Q代表查询,U代表修改
  ({{ Generator }}:GeneCode)
*/
export default class {{ TableName }}_DetailAiEx extends {{ TableName }}_DetailAi {
  /**
   * 按钮单击,用于调用Js函数中btnClick
   * ({{ Generator }}:Gen_Vue_TS_btnDetail_Click)
   **/
  public btnDetail_Click(strCommandName: string, key: {{ TableName }}Key) {
    const strThisFuncName = this.btnDetail_Click.name;
    {{~ if IsMultiKey ~}}
    console.log(key, strThisFuncName);
    {{~ else ~}}
    console.log(key, strThisFuncName);
    {{~ end ~}}
    let strMsg;
    switch (strCommandName) {
      case 'Detail': //详细信息
        {{~ if IsMultiKey ~}}
        this.btnDetailRecord_Click(key);
        {{~ else ~}}
        this.btnDetailRecord_Click(key);
        {{~ end ~}}
        break;
      default:
        {{~ if IsMultiKey ~}}
        strMsg = `命令:${strCommandName}, 关键字: ${JSON.stringify(key)}, 在函数({{ TableName }}_Detail.btnClick)中没有被处理!`;
        {{~ else ~}}
        strMsg = `命令:${strCommandName}, 关键字: ${JSON.stringify(key)}, 在函数({{ TableName }}_Detail.btnClick)中没有被处理!`;
        {{~ end ~}}
        console.error(strMsg);
        alert(strMsg);
        break;
    }
  }
}