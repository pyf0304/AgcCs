  /** 把实体列表组装成导出文件数据。 */
  public CombineData(
    arr{{ TableName }}ObjLst: Array<cls{{ TableName }}EN>,
    arrDataColumn: Array<clsDataColumn>,
  ): ExportExcelData {
    const arrData = this.BuildExportRowsByColumns(arr{{ TableName }}ObjLst, arrDataColumn, (obj, fld) =>
      obj.GetFldValue(fld),
    );
    const strFileName = Format('{{ TableCnName }}({0})导出.xlsx', cls{{ TableName }}EN._CurrTabName);
    const strSheetName = '{{ TableCnName }}列表';
    return { arrObjLst: arrData, sheetName: strSheetName, fileName: strFileName };
  }
    
  /** 绑定表格内容并同步分页器。 */
  {{~ if IsUseFunc ~}}
      public async BindTab_{{ TableName }}4Func(
        divContainer: HTMLDivElement,
        arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>,
      ) {
        const strThisFuncName = this.BindTab_{{ TableName }}4Func.name;
  {{~ else ~}}
      public async BindTab_{{ TableName }}(
        divContainer: HTMLDivElement,
        arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>,
      ) {
        const strThisFuncName = this.BindTab_{{ TableName }}.name;
  {{~ end ~}}
    if (divContainer == null) {
      alert(Format('{0}不存在!In {1}.{2}', divContainer, this.constructor.name, strThisFuncName));
      return;
    }

    const arrDataColumn: Array<clsDataColumn> = this.getListColumnsAi();

    if ({{ refListName }}.value != null) {
      dataColumn.value = arrDataColumn;
      {{~ if IsUseFunc ~}}
      try {
        await this.ExtendTdFldFuncMap(arr{{ TableName }}ExObjLst);
      } catch (e) {
        const strMsg = `扩展Td字段值的映射出错,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      {{~ end ~}}
      await BindTabByList(arr{{ TableName }}ExObjLst, this.dispAllErrMsg_q);
    } else {
      {{~ if IsUseFunc ~}}
      try {
        await this.ExtendFldFuncMap(arr{{ TableName }}ExObjLst, arrDataColumn);
      } catch (e) {
        const strMsg = `扩展字段值的映射出错,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      {{~ end ~}}
      const divDataLst = GetDivObjInDivObj(divContainer, 'divDataLst');
      if (divDataLst == null) {
        alert('在BindTab_{{ TableName }}{{~ if IsUseFunc ~}}4Func{{~ end ~}}函数中，divDataLst不存在!');
        return;
      }
      await BindTab(
        divDataLst,
        arr{{ TableName }}ExObjLst,
        arrDataColumn,
        cls{{ TableName }}EN.con_{{ KeyField }},
        this,
      );
    }

    if (this.objPager.IsInit(divContainer, this.divName4Pager) == false)
      this.objPager.InitShow(divContainer, this.divName4Pager);
    this.objPager.recCount = this.recCount;
    this.objPager.pageSize = this.pageSize;
    this.objPager.ShowPagerV2(divContainer, this, this.divName4Pager);
  }

  /** 按当前条件获取并绑定分页列表。 */
  
   {{~ if IsUseFunc ~}}
  public async BindGv_{{ TableName }}4Func(divList: HTMLDivElement) {
    const strThisFuncName = this.BindGv_{{ TableName }}4Func.name;
  {{~ else if UseCacheModeInList ~}}
  public async BindGv_{{ TableName }}Cache(divList: HTMLDivElement) {
    const strThisFuncName = this.BindGv_{{ TableName }}Cache.name;
  {{~ else ~}}
  public async BindGv_{{ TableName }}(divList: HTMLDivElement) {
    const strThisFuncName = this.BindGv_{{ TableName }}.name;
  {{~ end ~}}
    
    {{~ if !UseCacheModeInList ~}}
    if (divList == null) {
      const strMsg = Format(
        '用于显示列表的div为空,请检查!(in {0}.{1})',
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      return;
    }
    this.listPara.listDiv = divList;
    {{~ end ~}}
    if (viewVarSet.sort{{ TableName }}By == null) {
      const strMsg = Format(
        '在显示列表时,排序字段(sort{{ TableName }}By)为空,请检查!(In BindGv_{{ TableName }}Cache)',
      );
      console.error(strMsg);
      alert(strMsg);
      return;
    }

    {{~ if UseCacheModeInList ~}}
    const obj{{ TableName }}Cond = await Combine{{ TableName }}ConditionObj();
    const strWhereCond = JSON.stringify(obj{{ TableName }}Cond);
    {{~ else ~}}
    const strWhereCond = await Combine{{ TableName }}Condition();
    {{~ end ~}}
    const intCurrPageIndex = GetCurrPageIndex(this.objPager.currPageIndex);
    let arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx> = [];

    try {
      {{~ if UseCacheModeInList ~}}
            this.recCount = await {{ TableName }}_GetRecCountByCondCache(obj{{ TableName }}Cond{{CacheCondVars}});
      {{~ else ~}}
            this.recCount = await {{ TableName }}_GetRecCountByCondAsync(strWhereCond);
      {{~ end ~}}
      if (this.recCount == 0) {
        {{~ if UseCacheModeInList ~}}
            const strMsg = Format(
              '在绑定GvCache过程中,根据条件:[{0}]获取的对象列表数为0!',
              obj{{ TableName }}Cond.whereCond,
            );
            console.error(strMsg);
            alert(strMsg);
        {{~ else ~}}
            const lblMsg: HTMLSpanElement = <HTMLSpanElement>document.createElement('span');
            lblMsg.innerHTML = Format('根据条件:[{0}]获取的对象列表数为0!', strWhereCond);
            const strMsg = Format('在绑定Gv过程中,根据条件:[{0}]获取的对象列表数为0!', strWhereCond);
            console.error('Error: ', strMsg);
            alert(strMsg);
        {{~ end ~}}
        BindTabByList(arr{{ TableName }}ExObjLst, true);
        return;
      }

      {{~ if UseCacheModeInList ~}}
          let strSortFun = (x: any, y: any) => {
            console.log(x, y);
            return 0;
          };
          const currentCtor = this.constructor as typeof {{ TableName }}CRUDAi;
          if (currentCtor.sortFunStatic != undefined) {
            strSortFun = currentCtor.sortFunStatic(viewVarSet.ascOrDesc4SortFun);
          }
          const objPagerPara: stuPagerPara = {
            pageIndex: intCurrPageIndex,
            pageSize: this.pageSize,
            whereCond: strWhereCond,
            conditionCollection: obj{{ TableName }}Cond,
            orderBy: viewVarSet.sort{{ TableName }}By,
            sortFun: strSortFun,
          };
      

         {{~ if IsUseFunc ~}}
               arr{{ TableName }}ExObjLst = await {{ TableName }}Ex_GetObjExLstByPagerCache(objPagerPara{{CacheCondVars}});
         {{~ else ~}}
              arr{{ TableName }}ExObjLst = await {{ TableName }}_GetObjExLstByPagerCache(objPagerPara{{CacheCondVars}});
         {{~ end ~}}

      {{~ else ~}}
            const objPagerPara: stuPagerPara = {
                pageIndex: intCurrPageIndex,
                pageSize: this.pageSize,
                whereCond: strWhereCond,
                orderBy: viewVarSet.sort{{ TableName }}By,
                sortFun: (x, y) => {
                    console.log(x, y);
                    return 0;
                },
            };
                    
            {{~ if IsUseFunc ~}}
                arr{{ TableName }}ExObjLst = await {{ TableName }}Ex_GetObjExLstByPagerAsync(objPagerPara);
            {{~ else ~}}
                arr{{ TableName }}ExObjLst = await {{ TableName }}_GetObjLstByPagerAsync(objPagerPara);
            {{~ end ~}}
        
      {{~ end ~}}
    } catch (e) {
      const strMsg = `绑定GridView不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return;
    }

    if (arr{{ TableName }}ExObjLst.length == 0) {
      {{~ if !UseCacheMode ~}}
      const strKey = Format('{0}', cls{{ TableName }}EN._CurrTabName);
      const strMsg = `根据条件获取的${this.thisTabName}记录数为0!(Key=${strKey})`;
      console.error('Error: ', strMsg);
      {{~ end ~}}
      this.objPager.Hide(divList, this.divName4Pager);
      return;
    }

    try {
      
        {{~ if IsUseFunc ~}}
      await this.BindTab_{{ TableName }}4Func(divList, arr{{ TableName }}ExObjLst);
      {{~ else ~}}
      await this.BindTab_{{ TableName }}(divList, arr{{ TableName }}ExObjLst);
      {{~ end ~}}
    } catch (e) {
      const strMsg = `绑定${this.thisTabName}对象列表不成功, ${e}.(in ${this.constructor.name}.${strThisFuncName})`;
      console.error(strMsg);
      alert(strMsg);
    }
  }
 
{{~ if IsUseFunc ~}}
      /** 为非实体原生字段补充显示映射。 */
    public async ExtendFldFuncMap(
        arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>,
        arrDataColumn: Array<clsDataColumn>,
    ) {
        const arrFldName = cls{{ TableName }}EN._AttributeName;
        for (const objDataColumn of arrDataColumn) {
        if (IsNullOrEmpty(objDataColumn.fldName) == true) continue;
        if (arrFldName.indexOf(objDataColumn.fldName) > -1) continue;
        for (const objInFor of arr{{ TableName }}ExObjLst) {     
            await {{ TableName }}Ex_FuncMapByFldName(objDataColumn.fldName, objInFor);     
        }
        }
    }
{{~ end ~}}

{{~ if IsUseFunc ~}}
      /** 为表格Td字段补充显示映射。 */
    public async ExtendTdFldFuncMap(arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>) {
        const arrFldName = cls{{ TableName }}EN._AttributeName;
        const tdFieldNames = this.ResolveTdFieldNames(
          {{ refListName }}.value?.tdFieldNames,
        dataColumn.value,
        IsNullOrEmpty,
        );

        if (tdFieldNames.length === 0) return;

        for (const normalizedFldName of tdFieldNames) {
            if (arrFldName.indexOf(normalizedFldName) > -1) continue;
            for (const objInFor of arr{{ TableName }}ExObjLst) {
             await {{ TableName }}Ex_FuncMapByFldName(normalizedFldName, objInFor);
            }
        }
    }
     
{{~ end ~}}
  /**
   * 导出时使用的默认排序规则。
   * ⚠️ 这是一个示例方法，使用从导出区域字段中选择的前 2 个字段。
   * ⚠️ 请根据实际业务需求修改排序逻辑和字段选择。
   * 
   * 当前示例使用的字段：
   * - {{ SortField1 }} ({{ SortField1Type }})
   * - {{ SortField2 }} ({{ SortField2Type }})
   * 
   * 表中可用的所有字段：
   {{~ for field in AvailableFields ~}}
   * - {{ field.FieldName }} ({{ field.TypeScriptType }})
   {{~ end ~}}
   * 
   * 作者: AutoGCLib
   * 日期: {{ date.now | date.to_string '%Y-%m-%d' }}
   */
  public SortFunExportExcel(a: cls{{ TableName }}EN, b: cls{{ TableName }}EN): number {
    // 第一级排序：{{ SortField2 }}
    if (a.{{ SortField2 }} == b.{{ SortField2 }}) {
      if (a.{{ SortField2 }} == null) return -1;
      if (b.{{ SortField2 }} == null) return 1;
      return {{ SortField2CompareExpr }};
    } else {
      if (b.{{ SortField1 }} == null) return -1;
      if (a.{{ SortField1 }} == null) return 1;
      return {{ SortField1CompareExpr }};
    }
  }

  /** 列表排序入口。 */
  public async SortBy(objAnchorElement: any) {
    await this.SortByTemplate({
      objAnchorElement,
      currAscOrDesc: viewVarSet.ascOrDesc4SortFun,
      currSortBy: viewVarSet.sort{{ TableName }}By,
      onEntitySort: async (sortColumnKey: string, sortDirection: string) => {
        if (Object.prototype.hasOwnProperty.call(cls{{ TableName }}ENEx, sortColumnKey) == false) {
          return false;
        }
        this.SortColumn(sortColumnKey, sortDirection);
        return true;
      },
      onApplySortState: (sortBy, ascOrDesc4SortFun, sortFun) => {
        viewVarSet.sort{{ TableName }}By = sortBy;
        viewVarSet.ascOrDesc4SortFun = ascOrDesc4SortFun;
        const currentCtor = this.constructor as typeof {{ TableName }}CRUDAi;
        currentCtor.sortFunStatic = sortFun;
      },
      onRefresh: async () => {
            {{~ if IsUseFunc ~}}
      await this.BindGv_{{ TableName }}4Func(this.listPara.listDiv);
      {{~ else if UseCacheModeInList ~}}
      await this.BindGv_{{ TableName }}Cache(this.listPara.listDiv);
      {{~ else ~}}
      await this.BindGv_{{ TableName }}(this.listPara.listDiv);
      {{~ end ~}}
      },
    });
  }

