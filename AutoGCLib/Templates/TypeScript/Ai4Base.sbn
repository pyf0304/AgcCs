import { ExportExcelData } from '@/ts/PubFun/ExportExcelData';
import {
  Combine{{ TableName }}ConditionObj4ExportExcel,
  Combine{{ TableName }}ConditionObj,
  {{ TableName }}_DeleteKeyIdCache,
  divVarSet,
  viewVarSet,
  dataColumn,
  BindTabByList,
  ref{{ TableName }}_List,
} from '@/views/{{ ModuleName }}/{{ TableName }}VueShare';
import {
  {{ TableName }}_GetRecCountByCondCache,
  {{ TableName }}_GetSubObjLstCache,
  {{ TableName }}_ReFreshCache,
  {{ TableName }}_FuncMapByFldName,
  {{ TableName }}_GetObjExLstByPagerCache,
  {{ TableName }}_GetObjLstBy{{ TableName }}IdLstAsync,
  {{ TableName }}_UpdateRecordAsync,
  {{ TableName }}_Del{{ TableName }}sAsync,
} from '@/ts/L3ForWApi/{{ ModuleName }}/cls{{ TableName }}WApi';
{{~ for feature in SetFieldFeatures ~}}
import { {{ feature.RelatedTableName }}_BindDdl_{{ feature.FieldName }}InDivCache } from '@/ts/L3ForWApi/SysPara/cls{{ feature.RelatedTableName }}WApi';
{{~ end ~}}
import {
  GetCheckedKeyIdsInDivObj,
  GetSelectValueInDivObj,
  GetDivObjInDivObj,
} from '@/ts/PubFun/clsCommFunc4Ctrl';
import { IsNullOrEmpty, Format } from '@/ts/PubFun/clsString';
import { cls{{ TableName }}ENEx } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}ENEx';
import { cls{{ TableName }}EN } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}EN';
import { ObjectAssign, BindTab, confirmDel } from '@/ts/PubFun/clsCommFunc4Web';
import { stuPagerPara } from '@/ts/PubFun/stuPagerPara';
import { clsDataColumn } from '@/ts/PubFun/clsDataColumn';
import { clsOperateList, GetCurrPageIndex } from '@/ts/PubFun/clsOperateList';
import { AIOperateListBase } from '@/viewsBase/common/AIOperateListBase';
import {
  getExportColumnSpecsAi2,
  getListColumnsAi2,
} from '@/viewsBase/{{ ModuleName }}/{{ TableName }}CRUDAi2Columns';

/**
 * Ai4版基类：
 * 在Ai3基础上增加命令schema驱动，不改变原有基类行为。
 */
export abstract class {{ TableName }}CRUDAi4 extends AIOperateListBase implements clsOperateList {
  public static vuebtn_Click: (strCommandName: string, strKeyId: any) => void;
  public static GetPropValue: (strPropName: string) => string;
  public static sortFunStatic: (ascOrDesc: string) => (x: any, y: any) => number;
  public recCount = 0;

  constructor() {
    super(divVarSet.refDivLayout, divVarSet.refDivList);
  }

  public get thisTabName(): string {
    return cls{{ TableName }}EN._CurrTabName;
  }

  public get dispAllErrMsg_q(): boolean {
    return true;
  }

  public async InitVarSet(): Promise<void> {
    // no-op
  }

  public async InitCtlVar(): Promise<void> {
    // no-op
  }

  protected getListColumnsAi(): Array<clsDataColumn> {
    return getListColumnsAi2();
  }

  protected getExportColumnSpecsAi(): Array<{ colHeader: string }> {
    return getExportColumnSpecsAi2();
  }

  public abstract SortColumn(sortColumnKey: string, sortDirection: string): void;

  /** 页面初始化 */
  public async PageLoadCache() {
    try {
      await this.InitVarSet();
      await this.InitCtlVar();
      if (viewVarSet.sort{{ TableName }}By == '') {
        viewVarSet.sort{{ TableName }}By = `${cls{{ TableName }}EN.con_{{ KeyField }}} Asc`;
      }
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
    } catch (e) {
      const strMsg = `页面启动不成功,${e}.(in ${this.constructor.name}.${this.PageLoadCache.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  /**
   * 查询按钮点击事件处理：调用基类QueryClickTemplate执行查询
   *
   * 职责：
   * 1. 重置页码到第1页
   * 2. 根据查询条件刷新数据
   *
   * 使用场景：用户点击查询按钮时触发
   */
  public async btnQuery_Click() {
    await this.QueryClickTemplate(async () => {
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
    });
  }

{{~ for feature in SetFieldFeatures ~}}
  public async SetDdl_{{ feature.FieldName }}InDivInFeature() {
    await {{ feature.RelatedTableName }}_BindDdl_{{ feature.FieldName }}InDivCache(divVarSet.refDivFunction, '{{ feature.DdlId }}');
  }

  /**
   * 设置{{ feature.FieldCnName }}按钮点击事件处理
   *
   * 流程：
   * 1. 验证是否选中了记录
   * 2. 验证是否选择了有效的{{ feature.FieldCnName }}
   * 3. 执行批量设置操作
   * 4. 操作完成后刷新数据列表
   *
   * 使用场景：用户选择多条记录后，点击"设置{{ feature.FieldCnName }}"按钮
   */
  public async {{ feature.ButtonMethodName }}() {
    try {
      const str{{ feature.FieldName }} = GetSelectValueInDivObj(
        divVarSet.refDivFunction,
        '{{ feature.DdlId }}_SetFldValue',
      );
      await this.ExecuteSelectionActionTemplate({
        selectedKeys: GetCheckedKeyIdsInDivObj(divVarSet.refDivList),
        emptySelectionMessage: `请选择需要设置{{ feature.FieldCnName }}的${this.thisTabName}记录!`,
        beforeExecute: () => {
          if (str{{ feature.FieldName }} == '') {
            const strMsg = '请输入{{ feature.FieldCnName }}({{ feature.FieldName }})!';
            console.error(strMsg);
            alert(strMsg);
            return false;
          }
          return true;
        },
        execute: async (arrKeyIds) => {
          await this.{{ feature.MethodName }}(arrKeyIds, str{{ feature.FieldName }});
        },
        onAfterExecute: async () => {
          await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
        },
      });
    } catch (e) {
      const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${this.{{ feature.ButtonMethodName }}.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}
{{~ if HasDeleteFeature ~}}
  /**
   * 删除记录按钮点击事件处理
   *
   * 流程：
   * 1. 验证是否选中了要删除的记录
   * 2. 弹出确认对话框，要求用户确认删除
   * 3. 执行批量删除操作
   * 4. 操作完成后刷新数据列表
   *
   * 使用场景：用户选择多条记录后，点击"删除"按钮
   */
  public async btnDelRecord_Click() {
    try {
      await this.ExecuteSelectionActionTemplate({
        selectedKeys: GetCheckedKeyIdsInDivObj(divVarSet.refDivList),
        emptySelectionMessage: `请选择需要删除的${this.thisTabName}记录!`,
        beforeExecute: (arrKeyIds) => confirmDel(arrKeyIds.length),
        execute: async (arrKeyIds) => {
          await this.DelMultiRecord(arrKeyIds);
        },
        onAfterExecute: async () => {
          await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
        },
      });
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${this.btnDelRecord_Click.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  public async DelMultiRecord(arr{{ TableName }}Id: Array<string>) {
    const strThisFuncName = this.DelMultiRecord.name;
    try {
      const returnInt = await {{ TableName }}_Del{{ TableName }}sAsync(arr{{ TableName }}Id);
      if (returnInt > 0) {
        {{ TableName }}_ReFreshCache();
        alert(`删除${this.thisTabName}记录成功,共删除${returnInt}条记录!`);
      } else {
        alert(`删除${this.thisTabName}记录不成功!`);
      }
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}
{{~ for feature in SetFieldFeatures ~}}
  /** 批量设置{{ feature.FieldCnName }}。 */
  public async {{ feature.MethodName }}(arr{{ TableName }}Id: Array<string>, str{{ feature.FieldName }}: string) {
    const strThisFuncName = this.{{ feature.MethodName }}.name;
    if (str{{ feature.FieldName }} == null || str{{ feature.FieldName }} == '') {
      alert('请输入{{ feature.FieldCnName }}({{ feature.FieldName }})!');
      return '';
    }
    if (arr{{ TableName }}Id.length == 0) {
      alert('没有选择记录,不能设置字段值!');
      return '';
    }

    try {
      const arr{{ TableName }}ObjLst = await {{ TableName }}_GetObjLstBy{{ TableName }}IdLstAsync(
        arr{{ TableName }}Id,
      );
      let intCount = 0;
      for (const objInFor of arr{{ TableName }}ObjLst) {
        const obj{{ TableName }}EN = new cls{{ TableName }}EN();
        ObjectAssign(obj{{ TableName }}EN, objInFor);
        obj{{ TableName }}EN.Set{{ KeyField }}(objInFor.{{ TableNameCamel }}Id);
        obj{{ TableName }}EN.Set{{ feature.FieldName }}(str{{ feature.FieldName }});

        let returnBool = false;
        try {
          obj{{ TableName }}EN.sfUpdFldSetStr = obj{{ TableName }}EN.updFldString;
          returnBool = await {{ TableName }}_UpdateRecordAsync(obj{{ TableName }}EN);
        } catch (e) {
          const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
          console.error(strMsg);
          throw strMsg;
        }

        if (returnBool == true) {
          {{ TableName }}_DeleteKeyIdCache(objInFor.{{ TableNameCamel }}Id);
          intCount++;
        } else {
          alert('设置记录不成功!');
        }
      }

      alert(`共设置了${intCount}条记录!`);
      if (intCount > 0) {
        {{ TableName }}_ReFreshCache();
      }
    } catch (e) {
      const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}
  /** 按当前查询条件导出原始列表数据。 */
  public async ExportExcel_{{ TableName }}Cache(): Promise<ExportExcelData> {
    const strThisFuncName = this.ExportExcel_{{ TableName }}Cache.name;
    if (viewVarSet.sort{{ TableName }}By == null) {
      const strMsg = Format(
        '在显示列表时,排序字段(sort{{ TableName }}By)为空,请检查!(In BindGv_{{ TableName }}Cache)',
      );
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    const obj{{ TableName }}Cond = await Combine{{ TableName }}ConditionObj4ExportExcel();
    let arr{{ TableName }}ObjLst: Array<cls{{ TableName }}EN> = [];
    try {
      this.recCount = await {{ TableName }}_GetRecCountByCondCache(obj{{ TableName }}Cond);
      if (this.recCount == 0) {
        const strMsg = Format(
          '在绑定GvCache过程中,根据条件:[{0}]获取的对象列表数为0!',
          obj{{ TableName }}Cond.whereCond,
        );
        console.error(strMsg);
        alert(strMsg);
        return { arrObjLst: [], sheetName: '', fileName: '' };
      }
      arr{{ TableName }}ObjLst = await {{ TableName }}_GetSubObjLstCache(obj{{ TableName }}Cond);
    } catch (e) {
      const strMsg = `绑定GridView不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    if (arr{{ TableName }}ObjLst.length == 0) {
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    try {
      const arrDataColumn = this.getListColumnsAi();
      arr{{ TableName }}ObjLst = arr{{ TableName }}ObjLst.sort(this.SortFunExportExcel);
      return this.CombineData(arr{{ TableName }}ObjLst, arrDataColumn);
    } catch (e) {
      const strMsg = `绑定${this.thisTabName}对象列表不成功, ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }
  }

  /** 按导出列规格整理导出结果。 */
  public async ExportExcel_{{ TableName }}CacheAi2(): Promise<ExportExcelData> {
    const raw = await this.ExportExcel_{{ TableName }}Cache();
    if (raw.arrObjLst.length === 0) return raw;
    const normalizedRows = this.NormalizeExportRowsBySpecs(
      raw.arrObjLst as Array<Record<string, any>>,
      this.getExportColumnSpecsAi(),
    );

    return {
      arrObjLst: normalizedRows,
      sheetName: raw.sheetName,
      fileName: raw.fileName,
    };
  }

  /** 导出按钮入口。 */
  public async btnExportExcel_Click() {
    await this.ExportExcel_{{ TableName }}Cache();
  }

  /** 把实体列表组装成导出文件数据。 */
  public CombineData(
    arr{{ TableName }}ObjLst: Array<cls{{ TableName }}EN>,
    arrDataColumn: Array<clsDataColumn>,
  ): ExportExcelData {
    const arrData = this.BuildExportRowsByColumns(arr{{ TableName }}ObjLst, arrDataColumn, (obj, fld) =>
      obj.GetFldValue(fld),
    );
    const strFileName = Format('{{ TableCnName }}({0})导出.xlsx', cls{{ TableName }}EN._CurrTabName);
    const strSheetName = '{{ TableCnName }}列表';
    return { arrObjLst: arrData, sheetName: strSheetName, fileName: strFileName };
  }

  /** 绑定表格内容并同步分页器。 */
  public async BindTab_{{ TableName }}4Func(
    divContainer: HTMLDivElement,
    arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>,
  ) {
    const strThisFuncName = this.BindTab_{{ TableName }}4Func.name;
    if (divContainer == null) {
      alert(Format('{0}不存在!', divContainer));
      return;
    }

    const arrDataColumn: Array<clsDataColumn> = this.getListColumnsAi();

    if (ref{{ TableName }}_List.value != null) {
      dataColumn.value = arrDataColumn;
      try {
        await this.ExtendTdFldFuncMap(arr{{ TableName }}ExObjLst);
      } catch (e) {
        const strMsg = `扩展Td字段值的映射出错,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      await BindTabByList(arr{{ TableName }}ExObjLst, this.dispAllErrMsg_q);
    } else {
      try {
        await this.ExtendFldFuncMap(arr{{ TableName }}ExObjLst, arrDataColumn);
      } catch (e) {
        const strMsg = `扩展字段值的映射出错,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      const divDataLst = GetDivObjInDivObj(divContainer, 'divDataLst');
      if (divDataLst == null) {
        alert('在BindTab_{{ TableName }}4Func函数中，divDataLst不存在!');
        return;
      }
      await BindTab(
        divDataLst,
        arr{{ TableName }}ExObjLst,
        arrDataColumn,
        cls{{ TableName }}EN.con_{{ KeyField }},
        this,
      );
    }

    if (this.objPager.IsInit(divContainer, this.divName4Pager) == false)
      this.objPager.InitShow(divContainer, this.divName4Pager);
    this.objPager.recCount = this.recCount;
    this.objPager.pageSize = this.pageSize;
    this.objPager.ShowPagerV2(divContainer, this, this.divName4Pager);
  }

  /** 按当前条件获取并绑定分页列表。 */
  public async BindGv_{{ TableName }}4Func(divList: HTMLDivElement) {
    const strThisFuncName = this.BindGv_{{ TableName }}4Func.name;
    if (viewVarSet.sort{{ TableName }}By == null) {
      const strMsg = Format(
        '在显示列表时,排序字段(sort{{ TableName }}By)为空,请检查!(In BindGv_{{ TableName }}Cache)',
      );
      console.error(strMsg);
      alert(strMsg);
      return;
    }

    const obj{{ TableName }}Cond = await Combine{{ TableName }}ConditionObj();
    const strWhereCond = JSON.stringify(obj{{ TableName }}Cond);
    const intCurrPageIndex = GetCurrPageIndex(this.objPager.currPageIndex);
    let arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx> = [];

    try {
      this.recCount = await {{ TableName }}_GetRecCountByCondCache(obj{{ TableName }}Cond);
      if (this.recCount == 0) {
        const strMsg = Format(
          '在绑定GvCache过程中,根据条件:[{0}]获取的对象列表数为0!',
          obj{{ TableName }}Cond.whereCond,
        );
        console.error(strMsg);
        alert(strMsg);
        BindTabByList(arr{{ TableName }}ExObjLst, true);
        return;
      }

      let strSortFun = (x: any, y: any) => {
        console.log(x, y);
        return 0;
      };
      const currentCtor = this.constructor as typeof {{ TableName }}CRUDAi4;
      if (currentCtor.sortFunStatic != undefined) {
        strSortFun = currentCtor.sortFunStatic(viewVarSet.ascOrDesc4SortFun);
      }
      const objPagerPara: stuPagerPara = {
        pageIndex: intCurrPageIndex,
        pageSize: this.pageSize,
        whereCond: strWhereCond,
        conditionCollection: obj{{ TableName }}Cond,
        orderBy: viewVarSet.sort{{ TableName }}By,
        sortFun: strSortFun,
      };
      arr{{ TableName }}ExObjLst = await {{ TableName }}_GetObjExLstByPagerCache(objPagerPara);
    } catch (e) {
      const strMsg = `绑定GridView不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return;
    }

    if (arr{{ TableName }}ExObjLst.length == 0) {
      this.objPager.Hide(divList, this.divName4Pager);
      return;
    }

    try {
      await this.BindTab_{{ TableName }}4Func(divList, arr{{ TableName }}ExObjLst);
    } catch (e) {
      const strMsg = `绑定${this.thisTabName}对象列表不成功, ${e}.(in ${this.constructor.name}.${strThisFuncName})`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  /** 为非实体原生字段补充显示映射。 */
  public async ExtendFldFuncMap(
    arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>,
    arrDataColumn: Array<clsDataColumn>,
  ) {
    const arrFldName = cls{{ TableName }}EN._AttributeName;
    for (const objDataColumn of arrDataColumn) {
      if (IsNullOrEmpty(objDataColumn.fldName) == true) continue;
      if (arrFldName.indexOf(objDataColumn.fldName) > -1) continue;
      for (const objInFor of arr{{ TableName }}ExObjLst) {
        await {{ TableName }}_FuncMapByFldName(objDataColumn.fldName, objInFor);
      }
    }
  }

  /** 为表格Td字段补充显示映射。 */
  public async ExtendTdFldFuncMap(arr{{ TableName }}ExObjLst: Array<cls{{ TableName }}ENEx>) {
    const arrFldName = cls{{ TableName }}EN._AttributeName;
    const tdFieldNames = this.ResolveTdFieldNames(
      ref{{ TableName }}_List.value?.tdFieldNames,
      dataColumn.value,
      IsNullOrEmpty,
    );

    if (tdFieldNames.length === 0) return;

    for (const normalizedFldName of tdFieldNames) {
      if (arrFldName.indexOf(normalizedFldName) > -1) continue;

      for (const objInFor of arr{{ TableName }}ExObjLst) {
        await {{ TableName }}_FuncMapByFldName(normalizedFldName, objInFor);
      }
    }
  }

  /** 导出时使用的默认排序规则。 */
  public SortFunExportExcel(a: cls{{ TableName }}EN, b: cls{{ TableName }}EN): number {
    if (a.userId == b.userId) {
      if (a.userId == null) return -1;
      if (b.userId == null) return 1;
      return a.userId.localeCompare(b.userId);
    } else {
      if (b.dataBaseName == null) return -1;
      if (a.dataBaseName == null) return 1;
      return a.dataBaseName.localeCompare(b.dataBaseName);
    }
  }

  /** 列表排序入口。 */
  public async SortBy(objAnchorElement: any) {
    await this.SortByTemplate({
      objAnchorElement,
      currAscOrDesc: viewVarSet.ascOrDesc4SortFun,
      currSortBy: viewVarSet.sort{{ TableName }}By,
      onEntitySort: async (sortColumnKey: string, sortDirection: string) => {
        if (Object.prototype.hasOwnProperty.call(cls{{ TableName }}ENEx, sortColumnKey) == false) {
          return false;
        }
        this.SortColumn(sortColumnKey, sortDirection);
        return true;
      },
      onApplySortState: (sortBy, ascOrDesc4SortFun, sortFun) => {
        viewVarSet.sort{{ TableName }}By = sortBy;
        viewVarSet.ascOrDesc4SortFun = ascOrDesc4SortFun;
        const currentCtor = this.constructor as typeof {{ TableName }}CRUDAi4;
        currentCtor.sortFunStatic = sortFun;
      },
      onRefresh: async () => {
        await this.BindGv_{{ TableName }}4Func(this.listPara.listDiv);
      },
    });
  }

  /** 跳转到指定页。 */
  public async IndexPage(intPageIndex: number) {
    await this.IndexPageTemplate(intPageIndex, async () => {
      await this.BindGv_{{ TableName }}4Func(this.listPara.listDiv);
    });
  }

  /** 加载下一页。 */
  public async NextPage() {
    await this.NextPageTemplate(async () => {
      await this.BindGv_{{ TableName }}4Func(this.listPara.listDiv);
    });
  }

  /** 加载上一页。 */
  public async PrevPage() {
    await this.PrevPageTemplate(async () => {
      await this.BindGv_{{ TableName }}4Func(this.listPara.listDiv);
    });
  }

  /** 预留的容器绑定扩展点。 */
  public async BindInDiv(divBind: HTMLDivElement) {
    console.log(divBind);
  }
}