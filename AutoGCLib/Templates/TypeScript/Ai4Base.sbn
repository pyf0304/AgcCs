import { ExportExcelData } from '@/ts/PubFun/ExportExcelData';
import {
  {{~ if UseCacheModeInList ~}}
        Combine{{ TableName }}ConditionObj,                               
  {{~ else ~}}  
        Combine{{ TableName }}Condition,
  {{~ end ~}}

  divVarSet,
  viewVarSet,
  dataColumn,
  BindTabByList,
  {{ refListName }}
  {{CacheImportVars}}
} from '@/views{{strIsShare}}/{{ ModuleName }}/{{ TableName }}VueShare';
import {
  {{~ if UseCacheModeInList ~}}
        {{ TableName }}_GetRecCountByCondCache,
        {{~ if HasExportFeature ~}}
            {{ TableName }}_GetSubObjLstCache,
        {{~ end ~}}

        {{ TableName }}_GetObjExLstByPagerCache,        
  {{~ else ~}}
       
        {{ TableName }}_GetRecCountByCondAsync,
        {{~ if HasExportFeature ~}}
            {{ TableName }}_GetObjLstAsync,
        {{~ end ~}}
        {{~ if HasDeleteInTabFeature ~}}
            {{ TableName }}_DelRecordAsync,
        {{~ end ~}}
        {{~ if UseCacheMode ~}}
            {{ TableName }}_ReFreshCache,
        {{~ end ~}}
  {{~ end ~}}

  {{~ if HasCopyFeature ~}}
        {{ TableName }}_GetObjByKeyAsync,
        {{ TableName }}_AddNewRecordAsync,

        {{~ if KeyTypeName == "StringAutoAddPrimaryKey" ~}}        
                {{ TableName }}_GetMaxStrIdAsync,
        {{~ else if KeyTypeName == "StringAutoAddPrimaryKeyWithPrefix" ~}}
                {{ TableName }}_GetMaxStrIdByPrefixAsync, 
        {{~ end ~}}
  {{~ end ~}}

  {{~ if IsUseFunc ~}}
          {{ TableName }}_FuncMapByFldName,
  {{~ end ~}}
  {{~ if HasCopyFeature || SetFieldFeatures.size>0  ~}}
        {{ TableName }}_GetObjLstBy{{ KeyField }}LstAsync,
  {{~ end ~}}
  {{ TableName }}_UpdateRecordAsync,  
  
  {{~ if IsMultiKey ~}}
        {{ TableName }}_DelRecKeyLstsAsync,
  {{~ else ~}}
        {{ TableName }}_DelKeysAsync,
  {{~ end ~}}
  {{ TableName }}_DelRecordAsync,
} from '@/ts/L3ForWApi/{{ ModuleName }}/cls{{ TableName }}WApi';
{{~ if IsUseFunc ~}}
import {
  {{ TableName }}Ex_FuncMapByFldName,
    {{~ if UseCacheModeInList ~}}        
        {{~ if IsUseFunc ~}}
            {{ TableName }}Ex_GetObjExLstByPagerCache,        
        {{~ end ~}}
      {{~ else ~}}
          {{~ if IsUseFunc ~}}
              {{ TableName }}Ex_GetObjExLstByPagerAsync,        
          {{~ end ~}}
    {{~ end ~}}
} from '@/ts/L3ForWApiEx{{strIsShare}}/{{ ModuleName }}/cls{{ TableName }}ExWApi';
{{~ end ~}}


import {
  GetCheckedKeyIdsInDivObj,
  GetSelectValueInDivObj,
  GetDivObjInDivObj,
} from '@/ts/PubFun/clsCommFunc4Ctrl';
import { IsNullOrEmpty, Format } from '@/ts/PubFun/clsString';
import { cls{{ TableName }}ENEx } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}ENEx';
import { cls{{ TableName }}EN, {{ TableName }}Key } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}EN';
import { ObjectAssign, BindTab, confirmDel } from '@/ts/PubFun/clsCommFunc4Web';
import { stuPagerPara } from '@/ts/PubFun/stuPagerPara';
import { clsDataColumn } from '@/ts/PubFun/clsDataColumn';
import { clsOperateList, GetCurrPageIndex } from '@/ts/PubFun/clsOperateList';
import { AIOperateListBase } from '@/viewsBase/common/AIOperateListBase';
import {
  getExportColumnSpecsAi,
  getListColumnsAi,
} from '@/viewsBase/{{ ModuleName }}/{{ TableName }}CRUDColumns';

/**
 * Ai版基类：
 * 在Ai3基础上增加命令schema驱动，不改变原有基类行为。
 */
export abstract class {{ TableName }}CRUDAi extends AIOperateListBase implements clsOperateList {
  public static vuebtn_Click: (strCommandName: string, strKeyId: any) => void;
  public static GetPropValue: (strPropName: string) => string;
  public static sortFunStatic: (ascOrDesc: string) => (x: any, y: any) => number;
  public recCount = 0;

  constructor() {
    super(divVarSet.refDivLayout, divVarSet.refDivList);
  }

  public get thisTabName(): string {
    return cls{{ TableName }}EN._CurrTabName;
  }

  public get dispAllErrMsg_q(): boolean {
    return true;
  }

  public async InitVarSet(): Promise<void> {
    // no-op
  }

  public async InitCtlVar(): Promise<void> {
    // no-op
  }

  protected getListColumnsAi(): Array<clsDataColumn> {
    return getListColumnsAi();
  }

  protected getExportColumnSpecsAi(): Array<{ colHeader: string }> {
    return getExportColumnSpecsAi();
  }

  public abstract SortColumn(sortColumnKey: string, sortDirection: string): void;

  /** 页面初始化 */
  public async PageLoadCache() {
    try {
      await this.InitVarSet();
      await this.InitCtlVar();
      if (viewVarSet.sort{{ TableName }}By == '') {
        viewVarSet.sort{{ TableName }}By = `${cls{{ TableName }}EN.con_{{ KeyField }}} Asc`;
      }
      
      {{~ if IsUseFunc ~}}
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
      {{~ else if UseCacheModeInList ~}}
      await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
      {{~ else ~}}
      await this.BindGv_{{ TableName }}(divVarSet.refDivList);
      {{~ end ~}}
    } catch (e) {
      const strMsg = `页面启动不成功,${e}.(in ${this.constructor.name}.${this.PageLoadCache.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  /**
   * 查询按钮点击事件处理：调用基类QueryClickTemplate执行查询
   *
   * 职责：
   * 1. 重置页码到第1页
   * 2. 根据查询条件刷新数据
   *
   * 使用场景：用户点击查询按钮时触发
   */
  public async btnQuery_Click() {
    await this.QueryClickTemplate(async () => {
  
         {{~ if IsUseFunc ~}}
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
      {{~ else if UseCacheModeInList ~}}
      await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
      {{~ else ~}}
      await this.BindGv_{{ TableName }}(divVarSet.refDivList);
      {{~ end ~}}
    });
  }

    {{~ for feature in SetFieldFeatures ~}}
  /**
   * 设置{{ feature.FieldCnName }}按钮点击事件处理
   *
   * 流程：
   * 1. 验证是否选中了记录
   * 2. {{~ if feature.NeedsValidation ~}}验证是否选择了有效的{{ feature.FieldCnName }}{{~ else ~}}获取{{ feature.FieldCnName }}值{{~ end ~}}
   * 3. 执行批量设置操作
   * 4. 操作完成后刷新数据列表
   *
   * 使用场景：用户选择多条记录后，点击"设置{{ feature.FieldCnName }}"按钮
   */
  public async {{ feature.ButtonMethodName }}() {
    try {
      {{~ if feature.FieldTypeScript == "boolean" ~}}
      const {{ feature.ParamPrefix }}{{ feature.FieldName }}: boolean = $('#{{ feature.DdlId }}_SetFldValue').prop('checked'); // 布尔型下拉框直接获取checked属性
      {{~ else ~}}
      const {{ feature.ParamPrefix }}{{ feature.FieldName }} = GetSelectValueInDivObj(
        divVarSet.refDivFunction,
        '{{ feature.DdlId }}_SetFldValue',
      );
      {{~ end ~}}
      await this.ExecuteSelectionActionTemplate({
        selectedKeys: GetCheckedKeyIdsInDivObj(divVarSet.refDivList),
        emptySelectionMessage: `请选择需要设置{{ feature.FieldCnName }}的${this.thisTabName}记录!`,
        beforeExecute: () => {
          {{~ if feature.NeedsValidation ~}}
          if ({{ feature.ParamPrefix }}{{ feature.FieldName }} == '') {
            const strMsg = '请输入{{ feature.FieldCnName }}({{ feature.FieldName }})!';
            console.error(strMsg);
            alert(strMsg);
            return false;
          }
          {{~ end ~}}
          return true;
        },
        execute: async (arrKeyIds) => {
          await this.{{ feature.MethodName }}(arrKeyIds, {{ feature.ParamPrefix }}{{ feature.FieldName }});
        },
        onAfterExecute: async () => {
          {{~ if IsUseFunc ~}}
          await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
          {{~ else if UseCacheModeInList ~}}
          await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
          {{~ else ~}}
          await this.BindGv_{{ TableName }}(divVarSet.refDivList);
          {{~ end ~}}
        },
      });
    } catch (e) {
      const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${this.{{ feature.ButtonMethodName }}.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}

{{~ if HasDeleteFeature ~}}
  /**
   * 删除记录按钮点击事件处理
   *
   * 流程：
   * 1. 验证是否选中了要删除的记录
   * 2. 弹出确认对话框，要求用户确认删除
   * 3. 执行批量删除操作
   * 4. 操作完成后刷新数据列表
   *
   * 使用场景：用户选择多条记录后，点击"删除"按钮
   */
  public async btnDelRecord_Click() {
    try {
      await this.ExecuteSelectionActionTemplate({
        selectedKeys: GetCheckedKeyIdsInDivObj(divVarSet.refDivList),
        emptySelectionMessage: `请选择需要删除的${this.thisTabName}记录!`,
        beforeExecute: (arrKeyIds) => confirmDel(arrKeyIds.length),
        execute: async (arrKeyIds) => {
          await this.DelMultiRecord(arrKeyIds);
        },
        onAfterExecute: async () => {
         {{~ if IsUseFunc ~}}
          await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
          {{~ else if UseCacheModeInList ~}}
          await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
          {{~ else ~}}
          await this.BindGv_{{ TableName }}(divVarSet.refDivList);
          {{~ end ~}}
        },
      });
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${this.btnDelRecord_Click.name}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  public async DelMultiRecord(arr{{ KeyField }}: Array<string>) {
    const strThisFuncName = this.DelMultiRecord.name;
    try {
        {{~ if IsMultiKey ~}}
      const returnInt = await {{ TableName }}_DelRecKeyLstsAsync(arr{{ KeyField }});
      {{~ else ~}}
      const returnInt = await {{ TableName }}_DelKeysAsync(arr{{ KeyField }});
      {{~ end ~}}
      if (returnInt > 0) {       
        alert(`删除${this.thisTabName}记录成功,共删除${returnInt}条记录!`);
      } else {
        alert(`删除${this.thisTabName}记录不成功!`);
      }
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}

{{~ for feature in SetFieldFeatures ~}}
  /** 批量设置{{ feature.FieldCnName }}。 */
  public async {{ feature.MethodName }}(arr{{ KeyField }}: Array<string>, {{ feature.ParamPrefix }}{{ feature.FieldName }}: {{ feature.FieldTypeScript }}) {
    const strThisFuncName = this.{{ feature.MethodName }}.name;
    {{~ if feature.NeedsValidation ~}}
    if ({{ feature.ParamPrefix }}{{ feature.FieldName }} == null || {{ feature.ParamPrefix }}{{ feature.FieldName }} == '') {
      alert('请输入{{ feature.FieldCnName }}({{ feature.FieldName }})!');
      return '';
    }
    {{~ end ~}}
    if (arr{{ KeyField }}.length == 0) {
      alert('没有选择记录,不能设置字段值!');
      return '';
    }

    try {
      const arr{{ TableName }}ObjLst = await {{ TableName }}_GetObjLstBy{{ KeyField }}LstAsync(
        arr{{ KeyField }},
      );
      let intCount = 0;
      for (const objInFor of arr{{ TableName }}ObjLst) {
        const obj{{ TableName }}EN = new cls{{ TableName }}EN();
        ObjectAssign(obj{{ TableName }}EN, objInFor);
        obj{{ TableName }}EN.Set{{ KeyField }}(objInFor.{{ KeyFieldCamel }});
        obj{{ TableName }}EN.Set{{ feature.FieldName }}({{ feature.ParamPrefix }}{{ feature.FieldName }});

        let returnBool = false;
        try {
          obj{{ TableName }}EN.sfUpdFldSetStr = obj{{ TableName }}EN.updFldString;
          returnBool = await {{ TableName }}_UpdateRecordAsync(obj{{ TableName }}EN);
        } catch (e) {
          const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
          console.error(strMsg);
          throw strMsg;
        }

        if (returnBool == true) {
          {{~ if UseCacheMode ~}}          
            {{ TableName }}_DeleteKeyIdCache({{VarNameStr_DeleteKeyIdCache}}{ {{ KeyFieldCamel }}: objInFor.{{ KeyFieldCamel }} });        
          {{~ end ~}}
          intCount++;
        } else {
          alert('设置记录不成功!');
        }
      }

      alert(`共设置了${intCount}条记录!`);
      if (intCount > 0) {
        {{~ if UseCacheMode ~}}
               {{~ if HasCacheClassifyField ~}}
                     {{ TableName }}_ReFreshCache({{ VarNameStr_RefreshCache }});
               {{~ else ~}}
                    {{ TableName }}_ReFreshCache(); //缓存分类变量名 {{ VarNameStr_RefreshCache }}
               {{~ end ~}}
        {{~ else ~}}
                //{{ TableName }}_ReFreshCache();
        {{~ end ~}}
      }
    } catch (e) {
      const strMsg = `设置记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

{{~ end ~}}

{{~ if HasExportFeature ~}}
  /** 按当前查询条件导出原始列表数据。 */
  {{~ if UseCacheModeInList ~}}
  public async ExportExcel_{{ TableName }}Cache(): Promise<ExportExcelData> {
    const strThisFuncName = this.ExportExcel_{{ TableName }}Cache.name;
  {{~ else ~}}
  public async ExportExcel_{{ TableName }}(): Promise<ExportExcelData> {
    const strThisFuncName = this.ExportExcel_{{ TableName }}.name;
  {{~ end ~}}
    if (viewVarSet.sort{{ TableName }}By == null) {
      const strMsg = Format(
        '在显示列表时,排序字段(sort{{ TableName }}By)为空,请检查!(In BindGv_{{ TableName }}Cache)',
      );
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    {{~ if UseCacheModeInList ~}}
        const obj{{ TableName }}Cond = await Combine{{ TableName }}ConditionObj();
    {{~ else ~}}
        const strWhereCond = await Combine{{ TableName }}Condition();
    {{~ end ~}}
    let arr{{ TableName }}ObjLst: Array<cls{{ TableName }}EN> = [];
    try {
      {{~ if UseCacheModeInList ~}}
          this.recCount = await {{ TableName }}_GetRecCountByCondCache(obj{{ TableName }}Cond{{CacheCondVars}});
          if (this.recCount == 0) {
            const strMsg = Format(
              '在绑定GvCache过程中,根据条件:[{0}]获取的对象列表数为0!',
              obj{{ TableName }}Cond.whereCond,
            );
            console.error(strMsg);
            alert(strMsg);
            return { arrObjLst: [], sheetName: '', fileName: '' };
          }
          arr{{ TableName }}ObjLst = await {{ TableName }}_GetSubObjLstCache(obj{{ TableName }}Cond{{CacheCondVars}});
      {{~ else ~}}
          this.recCount = await {{ TableName }}_GetRecCountByCondAsync(strWhereCond);
          if (this.recCount == 0) {
            const lblMsg: HTMLSpanElement = <HTMLSpanElement>document.createElement('span');
            lblMsg.innerHTML = Format('根据条件:[{0}]获取的对象列表数为0!', strWhereCond);
            const strMsg = Format('在绑定Gv过程中,根据条件:[{0}]获取的对象列表数为0!', strWhereCond);
            console.error('Error: ', strMsg);
            //console.trace();
            alert(strMsg);
            return { arrObjLst: [], sheetName: '', fileName: '' };
          }
          arr{{ TableName }}ObjLst = await {{ TableName }}_GetObjLstAsync(strWhereCond);
      {{~ end ~}}
    } catch (e) {
      const strMsg = `绑定GridView不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    if (arr{{ TableName }}ObjLst.length == 0) {
      {{~ if !UseCacheMode ~}}
      const strMsg = `在ExportExcel过程中,根据条件获取的${this.thisTabName}记录数为0!`;
      console.error('Error: ', strMsg);
      //console.trace();
      alert(strMsg);
      {{~ end ~}}
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }

    try {
      const arrDataColumn = this.getListColumnsAi();
      arr{{ TableName }}ObjLst = arr{{ TableName }}ObjLst.sort(this.SortFunExportExcel);
      return this.CombineData(arr{{ TableName }}ObjLst, arrDataColumn);
    } catch (e) {
      const strMsg = `绑定${this.thisTabName}对象列表不成功, ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
      return { arrObjLst: [], sheetName: '', fileName: '' };
    }
  }

  /** 按导出列规格整理导出结果。 */
  {{~ if UseCacheModeInList ~}}
  public async ExportExcel_{{ TableName }}CacheAi(): Promise<ExportExcelData> {
    const raw = await this.ExportExcel_{{ TableName }}Cache();
  {{~ else ~}}
  public async ExportExcel_{{ TableName }}Ai(): Promise<ExportExcelData> {
    const raw = await this.ExportExcel_{{ TableName }}();
  {{~ end ~}}
    if (raw.arrObjLst.length === 0) return raw;
    const normalizedRows = this.NormalizeExportRowsBySpecs(
      raw.arrObjLst as Array<Record<string, any>>,
      this.getExportColumnSpecsAi(),
    );

    return {
      arrObjLst: normalizedRows,
      sheetName: raw.sheetName,
      fileName: raw.fileName,
    };
  }

  /** 导出按钮入口。 */
  public async btnExportExcel_Click() {
    {{~ if UseCacheModeInList ~}}
    await this.ExportExcel_{{ TableName }}Cache();
    {{~ else ~}}
    await this.ExportExcel_{{ TableName }}();
    {{~ end ~}}
  }

{{~ end ~}}
  
{{~ if HasCopyFeature ~}}
  /**
   * 复制记录按钮点击事件处理
   * 
   * 流程：
   * 1. 验证是否选中了要复制的记录
   * 2. 执行复制操作
   * 3. 操作完成后刷新数据列表
   * 
   * 使用场景：用户选择记录后，点击"复制"按钮
   * (AutoGCLib.WA_ViewScriptCS_TS4TypeScript:Gen_WApi_Ts_btnCopyRecord_Click)
   */
  public async btnCopyRecord_Click() {
    const strThisFuncName = this.btnCopyRecord_Click.name;
    try {
      const arrKeyIds = GetCheckedKeyIdsInDivObj(divVarSet.refDivList);
      if (arrKeyIds.length == 0) {
        alert(`请选择需要克隆的${this.thisTabName}记录!`);
        return '';
      }
      await this.CopyRecord(arrKeyIds);
        {{~ if IsUseFunc ~}}
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
      {{~ else if UseCacheModeInList ~}}
      await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
      {{~ else ~}}
      await this.BindGv_{{ TableName }}(divVarSet.refDivList);
      {{~ end ~}}
    } catch (e) {
      const strMsg = `复制记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  
 /**
   * 复制记录的具体实现
   * @param arr{{ KeyField }} 要复制的记录主键列表
   * (AutoGCLib.WA_ViewScriptCS_TS4TypeScript:Gen_WApi_Ts_CopyRecord)
   */
  public async CopyRecord(arr{{ KeyField }}: Array<string>) {
    const strThisFuncName = this.CopyRecord.name;
    try {
      const arr{{ TableName }}ObjLst = await {{ TableName }}_GetObjLstBy{{ KeyField }}LstAsync(
        arr{{ KeyField }},
      );
      let intCount = 0;
      for (const objInFor of arr{{ TableName }}ObjLst) {
        {{~ if KeyTypeName == "StringAutoAddPrimaryKey" ~}}        
            const strMaxStrId = await {{ TableName }}_GetMaxStrIdAsync();
            objInFor.{{ KeyFieldCamel }} = strMaxStrId; // 复制记录时，主键需要重新生成
            {{~ else if KeyTypeName == "StringAutoAddPrimaryKeyWithPrefix" ~}}
            const strMaxStrId = await {{ TableName }}_GetMaxStrIdByPrefixAsync(); 
            objInFor.{{ KeyFieldCamel }} = strMaxStrId; // 复制记录时，主键需要重新生成
         {{~ end ~}}
         objInFor.{{ NameFieldCamel }} = `${objInFor.{{ NameFieldCamel }} }_复制`; // 这里简单地在名称后面加上"_复制"，实际情况可以根据需要调整
 
        const returnBool = await {{ TableName }}_AddNewRecordAsync(objInFor);
        if (returnBool == true) {
             {{~ if UseCacheMode ~}}
                {{~ if HasCacheClassifyField ~}}                    
                    {{ TableName }}_ReFreshCache({{ VarNameStr_RefreshCache }});
                {{~ else ~}}
                    {{ TableName }}_ReFreshCache(); //{{ VarNameStr_RefreshCache }}
                {{~ end ~}}
            {{~ end ~}}
          intCount++;
        } else {
          const strInfo = Format('克隆记录不成功!');
          alert(strInfo);
        }
      }
      const strInfo = Format('共克隆了{0}条记录!', intCount);
      alert(strInfo);
    } catch (e) {
      const strMsg = `复制记录不成功,${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error('Error: ', strMsg);
      alert(strMsg);
    }
  }



{{~ end ~}}
{{~ if HasDeleteInTabFeature ~}}
  /**
   * 在数据表里删除记录
   * @param strKeyId 表关键字
   * (AutoGCLib.WA_ViewScriptCS_TS4TypeScript:Gen_WApi_Ts_btnDelRecordInTab_Click)
   */
  public async btnDelRecordInTab_Click(key: {{ TableName }}Key) {
    const strThisFuncName = this.btnDelRecordInTab_Click.name;
    try {
       {{~ for keyField in KeyFields ~}}
           {{~ if (keyField.IsNumber) ~}}
               if ({{ keyField.FieldNameCamel }} === 0) {
           {{~ else ~}}
                if (IsNullOrEmpty(key.{{ keyField.FieldNameCamel }}) || key.{{ keyField.FieldNameCamel }}  === {{ keyField.InitValue }}) {
                    alert(`请选择需要删除的${this.thisTabName}记录!`);
                    return '';
                }
           {{~ end ~}}
       {{~ end ~}}

      if (confirmDel(0) == false) {
        return;
      }
      await this.DelRecord(key);
      
      {{~ if IsUseFunc ~}}
      await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
      {{~ else if UseCacheModeInList ~}}
      await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
      {{~ else ~}}
      await this.BindGv_{{ TableName }}(divVarSet.refDivList);
      {{~ end ~}}
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

  /**
   * 根据关键字删除记录
   * @param keyId 记录主键
   * (AutoGCLib.WA_ViewScriptCS_TS4TypeScript:Gen_WApi_Ts_DelRecord)
   */
  public async DelRecord(key: {{ TableName }}Key) {
    const strThisFuncName = this.DelRecord.name;
    try {
      const returnInt = await {{ TableName }}_DelRecordAsync(key);
      if (returnInt > 0) {
        const strInfo = `删除${this.thisTabName}记录成功,共删除${returnInt}条记录!`;
        alert(strInfo);
      } else {
        const strInfo = `删除${this.thisTabName}记录不成功!`;
        alert(strInfo);
      }
      console.log('完成DelRecord!');
    } catch (e) {
      const strMsg = `删除${this.thisTabName}记录不成功. ${e}.(in ${this.constructor.name}.${strThisFuncName}`;
      console.error(strMsg);
      alert(strMsg);
    }
  }

