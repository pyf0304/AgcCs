<template>
	<div id="divLayout" ref="refDivLayout" class="div_layout">
		<div style="position: relative; width: 648px; height: 37px; left: 0px; top: 0px">
			<label id="lblViewTitle" name="lblViewTitle" class="h5">{{ "{{" }} strTitle {{ "}}" }} </label>
			<label id="lblMsg_List" name="lblMsg_List" class="text-warning" style="width: 250px"> </label>
		</div>

		<div id="divQuery" ref="refDivQuery" class="div_query">
			<table
			  id="tabEdit"
			  style="width: 900px"
			  class="table table-bordered table-hover table td table-sm"
      >
				<tbody>
					<tr>
						<template v-for="field in queryRow1" :key="field.key">
							<td class="text-right">
								<label class="col-form-label text-right" style="width: 90px">
									{{ "{{" }}
									field.label
									{{ "}}" }}
								</label>
							</td>
							<td class="text-left">
								<input
								  v-if="field.controlType === 'text'"
								  :id="field.id"
								  class="form-control form-control-sm"
								  :style="{ width: field.width + 'px' }"
								  :value="getQueryValue(field.key)"
								  @input="setQueryValue(field.key, ($event.target as HTMLInputElement).value)"
                />
								<select
							  v-else-if="field.controlType === 'select4Bool'"
							  :id="field.id"
							  class="form-control form-control-sm"
							  :style="{ width: field.width + 'px' }"
							  :value="getQueryValue(field.key)"
							  @change="setQueryValue(field.key, ($event.target as HTMLSelectElement).value)"
                >
									<option value="0">选择是/否</option>
									<option value="true">是</option>
									<option value="false">否</option>
								</select>
								<select
								  v-else
								  :id="field.id"
								  class="form-control form-control-sm"
								  :style="{ width: field.width + 'px' }"
								  :value="getQueryValue(field.key)"
								  @change="setQueryValue(field.key, ($event.target as HTMLSelectElement).value)"
                >
									<option
									  v-for="(item, index) in getSelectOptions(field.optionsKey)"
									  :key="index"
									  :value="getSelectValue(item, field.optionsKey)"
                  >
										{{ "{{" }} getSelectText(item, field.optionsKey) {{ "}}" }}
									</option>
								</select>
							</td>
						</template>
					</tr>
					<tr>
						<template v-for="field in queryRow2" :key="field.key">
							<td class="text-right">
								<label class="col-form-label text-right" style="width: 90px">
									{{ "{{" }}
									field.label
									{{ "}}" }}
								</label>
							</td>
							<td class="text-left">
								<input
							  v-if="field.controlType === 'text'"
							  :id="field.id"
							  class="form-control form-control-sm"
							  :style="{ width: field.width + 'px' }"
							  :value="getQueryValue(field.key)"
							  @input="setQueryValue(field.key, ($event.target as HTMLInputElement).value)"
                />
								<select
								  v-else-if="field.controlType === 'select4Bool'"
								  :id="field.id"
								  class="form-control form-control-sm"
								  :style="{ width: field.width + 'px' }"
								  :value="getQueryValue(field.key)"
								  @change="setQueryValue(field.key, ($event.target as HTMLSelectElement).value)"
                >
									<option value="0">选择是/否</option>
									<option value="true">是</option>
									<option value="false">否</option>
								</select>
								<select
								  v-else=""
								  :id="field.id"
								  class="form-control form-control-sm"
								  :style="{ width: field.width + 'px' }"
								  :value="getQueryValue(field.key)"
								  @change="setQueryValue(field.key, ($event.target as HTMLSelectElement).value)"
                >
									<option
									  v-for="(item, index) in getSelectOptions(field.optionsKey)"
									  :key="index"
									  :value="getSelectValue(item, field.optionsKey)"
                  >
										{{ "{{" }} getSelectText(item, field.optionsKey) {{ "}}" }}
									</option>
								</select>
							</td>
						</template>
						<td v-for="cmd in queryCommands" :key="cmd.id" class="text-left">
							<button
							  :id="cmd.elementId"
							  type="button"
							  :class="cmd.btnClass"
							  @click="runCommand(cmd.id)"
              >
								{{ "{{" }} cmd.text {{ "}}" }}
							</button>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div id="divFunction" ref="refDivFunction" class="table table-bordered table-hover">
			<ul class="nav">
				<li class="nav-item">
					<label id="lbl{{ TableName }}List" class="col-form-label text-info" style="width: 250px"
            >{{ TableCnName }}列表</label
          >
				</li>
				{{~ # 🔥 简化版：所有按钮统一渲染，不生成辅助控件（辅助控件在业务类中处理） ~}}
				<li v-for="cmd in featureCommands" :key="cmd.id" class="nav-item ml-3">
					<button :id="cmd.elementId" :class="cmd.btnClass" @click="runCommand(cmd.id)">
						{{ "{{" }} cmd.text {{ "}}" }}
					</button>
				</li>
			</ul>
		</div>

		<div id="divList" ref="refDivList" class="div_List">
			<{{ TableName }}_ListCom
        ref="ref{{ TableName }}_List"
        :items="dataList{{ TableName }}"
        :show-error-message="showErrorMessage"
        :empty-rec-num-info="emptyRecNumInfo"
        :data-column="dataColumn"
        @on-edit-tab-relainfo="EditTabRelaInfo"
        @on-sort-column="SortColumn"
      />
			<div id="divPager" class="pager"></div>
			<input id="hidSort{{ TableName }}By" type="hidden" />
		</div>

		<{{ TableName }}_EditCom ref="ref{{ TableName }}_Edit" />
		<{{ TableName }}_DetailCom ref="ref{{ TableName }}_Detail" />
	</div>
</template>

<script lang="ts">
	import 'jquery/dist/jquery.min.js';
	import 'bootstrap/dist/js/bootstrap.min.js';
	import 'bootstrap/dist/css/bootstrap.css';
	import { defineComponent, onMounted, ref } from 'vue';
	import * as XLSX from 'xlsx';
	import router from '@/router';
	import {
	divVarSet,
	refDivLayout,
	refDivQuery,
	refDivFunction,
	refDivList,
	ref{{ TableName }}_Edit,
	ref{{ TableName }}_Detail,
	ref{{ TableName }}_List,
	showErrorMessage,
	dataList{{ TableName }},
	emptyRecNumInfo,
	dataColumn,
	{{~ for field in QueryFields ~}}
	{{ field.Key }},
	{{~ end ~}}
	{{~ # 🔥 动态导入设置字段值的变量 ~}}
	{{~ for variable in SetFieldVariables ~}}
	{{ variable }},
	{{~ end ~}}
	{{~ # 🔥 新增：动态导入界面变量（如 ProgLangTypeId_Static, CodeTypeId_Static） ~}}
	{{~ for variable in ViewVariables ~}}
	{{ variable }},
	{{~ end ~}}
	} from '@/views/{{ ModuleName }}/{{ TableName }}VueShare';
	import {{ TableName }}_EditCom from '@/views/{{ ModuleName }}/{{ TableName }}_EditAi.vue';
	import {{ TableName }}_DetailCom from '@/views/{{ ModuleName }}/{{ TableName }}_DetailAi.vue';
	import {{ TableName }}_ListCom from '@/views/{{ ModuleName }}/{{ TableName }}_ListAi.vue';
	import { {{ TableName }}Key, } from '@/ts/L0Entity/{{ ModuleName }}/cls{{ TableName }}EN';
	
	{{~ # 🔥 动态导入查询区下拉框的实体类（使用正确的模块名，去重） ~}}
	{{~
	imported_entities = []
	for field in QueryFields
	if field.ControlType == "select" && field.OptionsWApiClass && field.OptionsModuleName
	entity_key = field.OptionsWApiClass + "_" + field.OptionsModuleName
	if !(imported_entities | array.contains entity_key)
	imported_entities = imported_entities | array.add entity_key
	~}}
	import { cls{{ field.OptionsWApiClass }}EN } from '@/ts/L0Entity/{{ field.OptionsModuleName }}/cls{{ field.OptionsWApiClass }}EN';
	{{~
	end
	end
	end
	~}}
	import { ExportExcelData } from '@/ts/PubFun/ExportExcelData';
	import {{ TableName }}CRUDAiEx from '@/views/{{ ModuleName }}/{{ TableName }}CRUDAiEx';
	import {
	getQueryRowsAi,
	initQueryDefaultsAi,
	loadFeatureOptionsAi,
	loadQueryOptionsAi,
	{{ TableName }}QueryFieldSpecAi,
	} from '@/viewsBase/{{ ModuleName }}/{{ TableName }}CRUDAiQuery';
	import {
	getFeatureCommandsAi,
	getQueryCommandsAi,
	{{ TableName }}CommandIdAi,
	{{ TableName }}CommandSpecAi,
	} from '@/viewsBase/{{ ModuleName }}/{{ TableName }}CRUDAiCommands';

	export default defineComponent({
	name: '{{ TableName }}CRUDAi',
	components: {
	{{ TableName }}_EditCom,
	{{ TableName }}_DetailCom,
	{{ TableName }}_ListCom,
	},
	setup() {
	{{~ # 🔥 界面变量初始化代码（直接输出） ~}}
	{{ ViewVariablesInitCode }}

	const strTitle = ref('{{ ViewTitle }}');
	const objPage = ref<{{ TableName }}CRUDAiEx>();
	 {{~ # 🔥 动态声明查询区下拉框的数据源变量 ~}}
      {{~ for field in QueryFields ~}}
      {{~ if field.ControlType == "select" && field.OptionsWApiClass ~}}
      const arr{{ field.OptionsWApiClass }} = ref<cls{{ field.OptionsWApiClass }}EN[] | null>([]);
      {{~ end ~}}
      {{~ end ~}}

			const { row1, row2 } = getQueryRowsAi();
			const queryRow1 = ref<Array<{{ TableName }}QueryFieldSpecAi>>(row1);
      const queryRow2 = ref<Array<{{ TableName }}QueryFieldSpecAi>>(row2);

      const queryCommands = ref<Array<{{ TableName }}CommandSpecAi>>(getQueryCommandsAi());
      const featureCommands = ref<Array<{{ TableName }}CommandSpecAi>>(getFeatureCommandsAi());

		  
      const getEnsurePageCaller = (): string => {
        const stack = new Error().stack;
        if (stack == null || stack === '') return 'unknown';

        const lines = stack
          .split('\n')
          .map((line) => line.trim())
          .filter((line) => line !== '');

        // stack格式通常为: Error -> getEnsurePageCaller -> ensurePage -> 调用者
        return lines[3] ?? lines[2] ?? 'unknown';
      };
		  
      const ensurePage = (strCaller: string): {{ TableName }}CRUDAiEx | null => {
        if (objPage.value == null) {
          const caller = getEnsurePageCaller();
          const errorMessage = `页面初始化不成功,请联系管理员! 调用者: ${strCaller}, 调用栈: ${caller}`;
          console.error(errorMessage);
		  alert(errorMessage);
          return null;
        }
        return objPage.value;
      };

      const getQueryValue = (key: {{ TableName }}QueryFieldSpecAi['key']): string => {
        switch (key) {
          {{~ for field in QueryFields ~}}
          case '{{ field.Key }}':
            return {{ field.Key }}.value;
          {{~ end ~}}
          default:
            return '';
        }
      };

      const setQueryValue = (key: {{ TableName }}QueryFieldSpecAi['key'], value: string) => {
        switch (key) {
          {{~ for field in QueryFields ~}}
          case '{{ field.Key }}':
            {{ field.Key }}.value = value;
            break;
          {{~ end ~}}
          default:
            break;
        }
      };

		        {{~ # 🔥 根据查询字段动态生成下拉框的选项类型 ~}}
      {{~ optionKeys = QueryFields | array.map "OptionsKey" | array.uniq | array.compact ~}}
      
      const getSelectOptions = (optionsKey?: {{~ for key in optionKeys ~}}'{{ key }}'{{~ if !for.last ~}} | {{~ end ~}}{{~ end ~}}) => {
        switch (optionsKey) {
          {{~ for field in QueryFields ~}}
          {{~ if field.OptionsKey ~}}
          case '{{ field.OptionsKey }}':
            return arr{{ field.OptionsWApiClass }}.value ?? [];
          {{~ end ~}}
          {{~ end ~}}
          default:
            return [];
        }
      };

      const getSelectValue = (item: any, optionsKey?: {{~ for key in optionKeys ~}}'{{ key }}'{{~ if !for.last ~}} | {{~ end ~}}{{~ end ~}}) => {
        switch (optionsKey) {
          {{~ for field in QueryFields ~}}
          {{~ if field.OptionsKey ~}}
          case '{{ field.OptionsKey }}':
            return item.{{ field.ValueFieldName }};
          {{~ end ~}}
          {{~ end ~}}
          default:
            return '';
        }
      };

      const getSelectText = (item: any, optionsKey?: {{~ for key in optionKeys ~}}'{{ key }}'{{~ if !for.last ~}} | {{~ end ~}}{{~ end ~}}) => {
        switch (optionsKey) {
          {{~ for field in QueryFields ~}}
          {{~ if field.OptionsKey ~}}
          case '{{ field.OptionsKey }}':
            return item.{{ field.TextFieldName }};
          {{~ end ~}}
          {{~ end ~}}
          default:
            return '';
        }
      };


      const exportToExcel = (
        arrData: Array<Record<string, any>>,
        strSheetName: string,
        strFileName: string,
      ) => {
        try {
          const worksheet = XLSX.utils.json_to_sheet(arrData);
          const workbook = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(workbook, worksheet, strSheetName);
          XLSX.writeFile(workbook, strFileName);
          alert('导出成功！');
        } catch (error) {
          console.error('导出失败:', error);
          alert('导出失败，请检查控制台日志！');
        }
      };

      const runCommand = async (commandId: {{ TableName }}CommandIdAi) => {
        const page = ensurePage(commandId);
        if (page == null) return;

        const result = await page.executeCommand(commandId);
        if (commandId === 'export' && result != null) {
          const data = result as ExportExcelData;
          if (data.sheetName === '') {
            alert('获取导出数据出错,请检查!');
            return;
          }
          exportToExcel(data.arrObjLst, data.sheetName, data.fileName);
        }
      };

      function GetPropValue(strPropName: string): string {
        switch (strPropName) {
          case 'strTitle':
            return strTitle.value;
          default:
            return '';
        }
      }

      function btn_Click(strCommandName: string, key: {{ TableName }}Key) {
        {{ TableName }}CRUDAiEx.btn_Click(strCommandName, key);
      }

      onMounted(async () => {
        initQueryDefaultsAi({
          {{~ for field in QueryFields ~}}
          {{ field.Key }},
          {{~ end ~}}
        });
		
    {{~ # 🔥 动态加载查询区下拉框数据 ~}}
        {{~ if QueryFields | array.any @(do; ret $0.ControlType == "select"; end) ~}}
        const queryOptions = await loadQueryOptionsAi();
        {{~ for field in QueryFields ~}}
        {{~ if field.ControlType == "select" && field.OptionsWApiClass ~}}
        arr{{ field.OptionsWApiClass }}.value = queryOptions.arr{{ field.OptionsWApiClass }};
        {{~ end ~}}
        {{~ end ~}}
        {{~ end ~}}
        
        {{~ # 🔥 只有存在设置字段值功能时才初始化相关变量 ~}}
        {{~ if HasSetFieldFeature ~}}
        const featureOptions = await loadFeatureOptionsAi();      
		console.log('featureOptions:', featureOptions);
        {{~ for variable in SetFieldVariables ~}}
        {{ variable }}.value = '0';
        {{~ end ~}}
        {{~ end ~}}

        {{ TableName }}CRUDAiEx.vuebtn_Click = btn_Click;
        {{ TableName }}CRUDAiEx.GetPropValue = GetPropValue;
        objPage.value = new {{ TableName }}CRUDAiEx();
        await objPage.value.PageLoadCache();
      });

      const SortColumn = async (data: any) => {
        const page = ensurePage('SortColumn');
        if (page == null) return;
        await page.SortColumn(data.sortColumnKey, data.sortDirection);
      };

      const EditTabRelaInfo = async (data: any) => {
        console.log('data:', data);
        router.push({ name: 'edit{{ TableName }}', params: { {{ KeyFieldCamel }}: data.{{ KeyFieldCamel }} } });
      };

      return {
        showErrorMessage,
        dataList{{ TableName }},
        emptyRecNumInfo,
        dataColumn,
        strTitle,
        ...divVarSet,
        refDivLayout,
        refDivQuery,
        refDivFunction,
        refDivList,
        ref{{ TableName }}_Edit,
        ref{{ TableName }}_Detail,
        ref{{ TableName }}_List,
        {{~ # 🔥 动态返回设置字段值的变量 ~}}
        {{~ for variable in SetFieldVariables ~}}
        {{ variable }},
        {{~ end ~}}
        
		    {{~ # 🔥 动态返回查询区下拉框的数据源变量 ~}}
        {{~ for field in QueryFields ~}}
        {{~ if field.ControlType == "select" && field.OptionsWApiClass ~}}
        arr{{ field.OptionsWApiClass }},
        {{~ end ~}}
        {{~ end ~}}
        queryRow1,
        queryRow2,
        queryCommands,
        featureCommands,
        getQueryValue,
        setQueryValue,
        getSelectOptions,
        getSelectValue,
        getSelectText,
        runCommand,
        SortColumn,
        EditTabRelaInfo,
      };
    },
  });

</script>

<style scoped=""></style>