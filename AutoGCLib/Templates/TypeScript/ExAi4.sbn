  {{~ # 🔥 为每个设置字段功能生成独立的方法 ~}}
  {{~ for mapping in CommandMappings ~}}
  {{~ if mapping.FeatureId == "0148" ~}}
  /**
   * {{ mapping.CommandName }} 操作
   * 设置字段值功能
   */
  public async on{{ mapping.MethodName }}() {
    await this.btn{{ mapping.MethodName }}_Click();
  }
  {{~ end ~}}
  {{~ end ~}}

  /**
   * 执行命令（命令模式入口）
   */
  public async executeCommand(commandId: {{ TableName }}CommandIdAi): Promise<ExportExcelData | void> {
    switch (commandId) {
      {{~ if HasQueryFeature ~}}
      case 'query':
        await this.onQuery();
        return;
      {{~ end ~}}
      {{~ if HasExportFeature ~}}
      case 'export':
        return await this.onExportAi();
      {{~ end ~}}
      {{~ if HasCreateFeature ~}}
      case 'create':
             {{~ if IsKeyFieldNumeric ~}}
        await this.onCreate('Create', null);
        {{~ else ~}}
        await this.onCreate('Create', null);
        {{~ end ~}}
        return;
      {{~ end ~}}
      {{~ if HasDetailFeature ~}}
      case 'detail':
             {{~ if IsKeyFieldNumeric ~}}
        await this.onDetail('Detail', null );
        {{~ else ~}}
        await this.onDetail('Detail', null );
        {{~ end ~}}
        return;
      {{~ end ~}}
      {{~ if HasCopyFeature ~}}
      case 'copy':
        await this.onCopy();
        return;
      {{~ end ~}}
      {{~ if HasUpdateFeature ~}}
      case 'update':
        await this.onUpdate('Update');
        return;
      {{~ end ~}}
      {{~ if HasDeleteFeature ~}}
          case 'delete':
            await this.onDelete();
            return;
      {{~ end ~}}
      {{~ if HasAdjustOrderNum ~}}
          case 'goTop':
            await this.onGoTop();
            return;
          case 'upMove':
            await this.onUpMove();
            return;
          case 'downMove':
            await this.onDownMove();
            return;
          case 'goBottom':
            await this.onGoBottom();
            return;
          case 'reOrder':
            await this.onReOrder();
            return;
      {{~ end ~}}

      {{~ # 🔥 动态生成设置字段值命令处理 ~}}
      {{~ for mapping in CommandMappings ~}}
          {{~ if mapping.FeatureId == "0148" ~}}
              // 🔥 {{ mapping.CommandName }} 命令
              case '{{ mapping.CommandId }}':
                await this.on{{ mapping.MethodName }}();
                return;
          {{~ end ~}}
      {{~ end ~}}
      default:
        return;
    }
  }

