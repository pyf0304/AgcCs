     {{~ if HasDetailFeature ~}}
  /**
   * 查看详情操作
   */
  public async onDetail(strCommandName: string, key: {{TableName}}Key | null) {
    const objPageDetail = new {{ TableName }}_DetailAiEx(this);
    console.log(objPageDetail);
    
    // 🔥 检查 key 是否为 null 或关键字段为空
    let actualKey = key;
    {{~ if IsMultiKey ~}}
    {{~ # 多关键字情况 ~}}
    if (key == null {{~ for keyField in KeyFields ~}} || key.{{ keyField.FieldNameCamel }} === {{~ if keyField.IsNumeric ~}}0{{~ else ~}}''{{~ end ~}} || key.{{ keyField.FieldNameCamel }} == null{{~ end ~}}) {
      // 从列表中获取第一个被选中的记录关键字
      const currentKeyLst = GetFirstCheckedKeyLstInDivObj(divVarSet.refDivList);
      const currKey = {{ TableName }}_SplitKeyLst(currentKeyLst);
      if (
        {{~ for keyField in KeyFields ~}}
        {{~ if for.first == false ~}} ||
        {{~ end ~}}currKey.{{ keyField.FieldNameCamel }} == null ||
        currKey.{{ keyField.FieldNameCamel }} === {{~ if keyField.IsNumeric ~}}0{{~ else ~}}''{{~ end ~}} ||
        currKey.{{ keyField.FieldNameCamel }} === 'undefined'{{~ end ~}}
      ) {
        const strMsg = `在查看详情时，获取记录关键字为:${JSON.stringify(currKey)},不成功!`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      actualKey = currKey;
    }
    {{~ else ~}}
    {{~ # 单关键字情况 ~}}
    {{~ if IsKeyFieldNumeric ~}}
    if (key == null || key.{{ KeyFieldCamel }} === 0 || key.{{ KeyFieldCamel }} == null) {
      // 从列表中获取第一个被选中的记录关键字
      const currentKeyId = GetFirstCheckedKeyIdInDivObj(divVarSet.refDivList);
      if (currentKeyId == null || currentKeyId === '' || currentKeyId === 'undefined') {
        const strMsg = `在查看详情时，获取记录关键字为:${currentKeyId},不成功!`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      actualKey = { {{ KeyFieldCamel }}: Number(currentKeyId) };
    }
    {{~ else ~}}
    if (key == null || key.{{ KeyFieldCamel }} === '' || key.{{ KeyFieldCamel }} == null) {
      // 从列表中获取第一个被选中的记录关键字
      const currentKeyId = GetFirstCheckedKeyIdInDivObj(divVarSet.refDivList);
      if (currentKeyId == null || currentKeyId === '' || currentKeyId === 'undefined') {
        const strMsg = `在查看详情时，获取记录关键字为:${currentKeyId},不成功!`;
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      actualKey = { {{ KeyFieldCamel }}: currentKeyId };
    }
    {{~ end ~}}
    {{~ end ~}}
    objPageDetail.btnDetail_Click(strCommandName, actualKey as {{TableName}}Key);
  }
