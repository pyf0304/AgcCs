  /**
   * 更新列表中指定关键字的勾选状态
   */
  private setCheckedRowsByKeyIds(arrKeyIds: Array<string>): void {
    const setKeyId = new Set(arrKeyIds);
    dataList{{ TableName }}.value.forEach((item: any) => {
      item.checked = setKeyId.has(item.{{KeyFieldCamel}});
    });
  }
      /**
       * 移顶操作
       */
      public async onGoTop() {
        const strThisFuncName = 'onGoTop';
        const arrKeyIds = GetCheckedKeyIdsInDivObj(divVarSet.refDivList);
        if (arrKeyIds.length === 0) {
          alert(`请选择需要置顶的${this.thisTabName}记录!`);
          return;
        }
        
        {{~ if ObjSortClassifyType.CtrlTypeId_Sort == "06" ~}}
            const {{ ObjSortClassifyType.PriVarName }} = GetSelectValueInDivObj(divVarSet.refDivFunction, '{{ ObjSortClassifyType.CtrlId }}');
            if (IsNullOrEmpty({{ ObjSortClassifyType.PriVarName }})) {
                alert(`请选择需要上移操作的分类字段，${this.thisTabName}记录!`);
                return;
            }
        {{~ end ~}}
        try {
          const objOrderByData: clsOrderByData = new clsOrderByData();
          objOrderByData.KeyIdLst = arrKeyIds;
          
          {{~ if SortClassifyLst4View.size==0 ~}}
              objOrderByData.ClassificationFieldValueLst = '{}';
          {{~ else ~}}
             {{~ if ObjSortClassifyType.CtrlTypeId_Sort == "06" ~}}
                const jsonObject = {
                    {{~ for sortClassifyObj in SortClassifyLst4View ~}}
                          {{ sortClassifyObj.FldNameCamel}}: {{ ObjSortClassifyType.PriVarName }},
                    {{~ end ~}}
                };
             {{~ else ~}}
                 const jsonObject = {
                    {{~ for sortClassifyObj in SortClassifyLst4View ~}}
                          {{ sortClassifyObj.FldNameCamel}}: {{sortClassifyObj.ViewVarName}}.value,
                    {{~ end ~}}
                };
            {{~ end ~}}
            const jsonStr = JSON.stringify(jsonObject);
            objOrderByData.ClassificationFieldValueLst = jsonStr;
          {{~ end ~}}
          await {{ TableName }}_GoTopAsync(objOrderByData);

        } catch (e) {
          const strMsg = `置顶出错。错误:${e}.(in {{ TableName }}CRUDAiEx.${strThisFuncName})`;
          console.error('Error: ', strMsg);
          alert(strMsg);
          return;
        }        
         {{~ if IsUseFunc ~}}
              await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
         {{~ else if UseCacheModeInList ~}}
              await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
         {{~ else ~}}
              await this.BindGv_{{ TableName }}(divVarSet.refDivList);
         {{~ end ~}}
        this.setCheckedRowsByKeyIds(arrKeyIds);
      }

