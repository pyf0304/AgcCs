      /**
       * 重序操作
       */
      public async onReOrder() {
        const strThisFuncName = 'onReOrder';
        {{~ if ObjSortClassifyType.CtrlTypeId_Sort == "06" ~}}
            const {{ ObjSortClassifyType.PriVarName }} = GetSelectValueInDivObj(divVarSet.refDivFunction, '{{ ObjSortClassifyType.CtrlId }}');
            if (IsNullOrEmpty({{ ObjSortClassifyType.PriVarName }})) {
                alert(`请选择需要上移操作的分类字段，${this.thisTabName}记录!`);
                return;
            }
        {{~ end ~}}

        try {
          const objOrderByData: clsOrderByData = new clsOrderByData();
          {{~ if SortClassifyLst4View.size==0 ~}}
              objOrderByData.ClassificationFieldValueLst = '{}';
          {{~ else ~}}
             {{~ if ObjSortClassifyType.CtrlTypeId_Sort == "06" ~}}
                const jsonObject = {
                    {{~ for sortClassifyObj in SortClassifyLst4View ~}}
                          {{ sortClassifyObj.FldNameCamel}}: {{ ObjSortClassifyType.PriVarName }},
                    {{~ end ~}}
                };
             {{~ else ~}}
                 const jsonObject = {
                    {{~ for sortClassifyObj in SortClassifyLst4View ~}}
                          {{ sortClassifyObj.FldNameCamel}}: {{sortClassifyObj.ViewVarName}}.value,
                    {{~ end ~}}
                };
            {{~ end ~}}
            const jsonStr = JSON.stringify(jsonObject);
            objOrderByData.ClassificationFieldValueLst = jsonStr;
          {{~ end ~}}
          await {{ TableName }}_ReOrderAsync(objOrderByData);

        } catch (e) {
          const strMsg = `重序出错。错误:${e}.(in {{ TableName }}CRUDAiEx.${strThisFuncName})`;
          console.error('Error: ', strMsg);
          alert(strMsg);
          return;
        }
        
        {{~ if IsUseFunc ~}}
              await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
         {{~ else if UseCacheModeInList ~}}
              await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
         {{~ else ~}}
              await this.BindGv_{{ TableName }}(divVarSet.refDivList);
         {{~ end ~}}
      }
 {{~ end ~}}



    /**
   * 静态按钮点击处理（兼容旧版本）
   */
  public static async btn_Click(strCommandName: string, key: {{TableName}}Key|null) {
    console.log('btn_Click', strCommandName, key);
    const objPage = new {{ TableName }}CRUDAiEx();
    let strMsg = '';

    switch (strCommandName) {
      {{~ if HasQueryFeature ~}}
      case 'Query':
      case 'btnQuery':
        await objPage.executeCommand('query');
        break;
      {{~ end ~}}

      {{~ if HasCreateFeature ~}}
      case 'AddNewRecordWithMaxId':
      case 'btnAddNewRecordWithMaxId':
      case 'CreateWithMaxId':
      case 'AddNewRecord':
      case 'btnAddNewRecord':
      case 'Create':
        await objPage.executeCommand('create');
        break;
      {{~ end ~}}

      {{~ if HasDetailFeature ~}}
      case 'Detail':
      case 'btnDetail':
        await objPage.onDetail(strCommandName, key);
        break;
      {{~ end ~}}

      {{~ if HasCopyFeature ~}}
      {{~ # 🔥 复制命令 ~}}
      case 'CopyRecord':
      case 'btnCopyRecord':
      case 'Clone':
        await objPage.executeCommand('copy');
        break;
      {{~ end ~}}

      {{~ if HasUpdateFeature ~}}
      case 'UpdateRecord':
      case 'btnUpdateRecord':
      case 'Update':
        await objPage.executeCommand('update');
        break;
      {{~ end ~}}

      {{~ if HasExportFeature ~}}
      case 'ExportExcel':
      case 'btnExportExcel':
        await objPage.executeCommand('export');
        break;
      {{~ end ~}}

      {{~ if HasDeleteFeature ~}}
      case 'DelRecord':
      case 'btnDelRecord':
      case 'Delete':
        await objPage.executeCommand('delete');
        break;
      {{~ end ~}}

      {{~ for mapping in CommandMappings ~}}
      {{~ if mapping.FeatureId == "0148" ~}}
      case '{{ mapping.CommandName }}':
      case 'btn{{ mapping.CommandName }}':
        await objPage.executeCommand('{{ mapping.CommandId }}');
        break;
      {{~ end ~}}
      {{~ end ~}}

      default:
        strMsg = `命令:${strCommandName}在函数({{ TableName }}CRUDExAi.btn_Click)中没有被处理!`;
        console.error(strMsg);
        alert(strMsg);
        break;
    }
  }

    /**
   * 列排序处理
   */
  public async SortColumn(sortColumnKey: string, sortDirection: string) {
    switch (sortColumnKey) {
      {{~ for column in SortColumns ~}}
      case '{{ column.ColumnKey }}':
        viewVarSet.sort{{ TableName }}By = {{ column.SortExpression }};
        break;
      {{~ end ~}}
      default:
        viewVarSet.sort{{ TableName }}By = Format('{0} {1}', sortColumnKey, sortDirection);
        break;
    }
    await {{ BindGvFuncName }}(this.listPara.listDiv);
  
  }
}

