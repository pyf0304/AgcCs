  public BindGv(strType: string, strPara: string) {
    this.BindGvCache(strType, strPara);
  }

  /**
   * 绑定数据视图（从缓存）
   */
  public async BindGvCache(strType: string, strPara: string) {
    console.log('strPara', strPara);
    switch (strType) {
      case '{{ TableName }}':
            {{~ if IsUseFunc ~}}
                  await this.BindGv_{{ TableName }}4Func(divVarSet.refDivList);
            {{~ else if UseCacheModeInList ~}}
                    await this.BindGv_{{ TableName }}Cache(divVarSet.refDivList);
            {{~ else ~}}
                    await this.BindGv_{{ TableName }}(divVarSet.refDivList);
            {{~ end ~}}
        break;
      default:
        AccessBindGvDefault(strType);
        break;
    }
  }

