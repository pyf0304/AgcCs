 */
export default class {{ TableName }}CRUDAiEx extends {{ TableName }}CRUDAi implements IShowList {
  public static vuebtn_Click: (strCommandName: string, key: {{TableName}}Key) => void;
  public static GetPropValue: (strPropName: string) => string;
  private static readonly pageSizeStorageKey = '{{ ModuleName }}.{{ TableName }}CRUDAi.PageSize';

  constructor() {
    super();
    this._pageSize = this.loadPageSizeFromStorage();
    this.objPager.onPageSizeChange = (ps: number) => {
      this._pageSize = ps;
      this.savePageSizeToStorage(ps);
    };
  }

  private loadPageSizeFromStorage(): number | null {
    try {
      const storedValue = localStorage.getItem({{ TableName }}CRUDAiEx.pageSizeStorageKey);
      if (storedValue == null || storedValue.trim() === '') {
        return null;
      }
      const parsed = Number(storedValue);
      if (Number.isInteger(parsed) && parsed > 0) {
        return parsed;
      }
      return null;
    } catch (error) {
      console.warn('读取分页大小缓存失败:', error);
      return null;
    }
  }

  private savePageSizeToStorage(pageSize: number): void {
    try {
      localStorage.setItem({{ TableName }}CRUDAiEx.pageSizeStorageKey, String(pageSize));
    } catch (error) {
      console.warn('保存分页大小缓存失败:', error);
    }
  }

  public get pageSize(): number {
    return this._pageSize ?? 10;
  }


  /**
   * 绑定数据视图（同步方法）
