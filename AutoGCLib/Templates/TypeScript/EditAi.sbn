  public async UpdateRecordSave(): Promise<boolean> {
    const strThisFuncName = this.UpdateRecordSave.name;
    const obj{{ TableName }}EN = await ref{{ TableName }}_Edit.value.GetEditData{{ TableName }}Obj();
    obj{{ TableName }}EN.Set{{ KeyField }}(this.keyId);
    obj{{ TableName }}EN.sfUpdFldSetStr = obj{{ TableName }}EN.updFldString;
    if (obj{{ TableName }}EN.{{ KeyFieldCamel }} == '' || obj{{ TableName }}EN.{{ KeyFieldCamel }} == undefined) {
      console.error('关键字不能为空!');
      throw '关键字不能为空!';
    }
    try {
      {{ TableName }}_CheckProperty4Update(obj{{ TableName }}EN);
