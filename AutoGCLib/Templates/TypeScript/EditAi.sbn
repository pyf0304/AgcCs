        this.keyId = { {{ KeyFieldCamel }}: returnString };
        {{~ else ~}}
        // 🔥 单关键字段：构造对象
        this.keyId = { {{ KeyFieldCamel }}: returnString };
        {{~ end ~}}
      }
    } catch (e) {
