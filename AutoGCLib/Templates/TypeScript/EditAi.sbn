    /** 确认提交按钮点击事件 */
  public async btnSubmit_Click() {
    const strThisFuncName = this.btnSubmit_Click.name;
    const strCommandText: string = this.btnSubmit{{ TableName }};
    try {
      let returnBool = false;
      {{~ if !IsMultiKey && NeedReturnKeyMethod ~}}
      {{~ if IsKeyFieldNumeric ~}}
      let returnKeyId: {{ ReturnKeyMethodReturnType }} = 0;
      {{~ else ~}}
      let returnKeyId: {{ ReturnKeyMethodReturnType }} = '';
      {{~ end ~}}
      {{~ end ~}}
      let strInfo = '';
      let strMsg = '';
      switch (strCommandText) {
        case '添加':
          this.btnSubmit{{ TableName }} = '确认添加';
          this.btnCancel{{ TableName }} = '取消添加';
          await this.AddNewRecord();
          break;
        case '确认添加':
          {{~ if IsMultiKey ~}}
          // 🔥 多关键字段：没有返回值概念，直接保存
          returnBool = await this.AddNewRecordSave();
          if (returnBool == true) {
            if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
              ref{{ TableName }}_Edit.value.hideDialog();
            }
            if (this.iShowList != null)
              {{~ if KeyFields.size > 0 ~}}
              // 🔥 多关键字段：使用第一个关键字段的值
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFields[0].FieldNameCamel }});
              {{~ else ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, '');
              {{~ end ~}}
          }
          {{~ else if NeedReturnKeyMethod ~}}
          // 🔥 单关键字段 + 需要返回值（Identity 或自增类型）
          returnKeyId = await this.AddNewRecordWithReturnKeySave();
          {{~ if IsKeyFieldNumeric ~}}
          if (returnKeyId != 0) {
          {{~ else ~}}
          if (IsNullOrEmpty(returnKeyId) == false) {
          {{~ end ~}}
            if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01)
              ref{{ TableName }}_Edit.value.hideDialog();
            if (this.iShowList != null)
              {{~ if IsKeyFieldNumeric ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, returnKeyId.toString());
              {{~ else ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, returnKeyId);
              {{~ end ~}}
          }
          {{~ else ~}}
          // 🔥 单关键字段 + 无需返回值（普通主键）
          returnBool = await this.AddNewRecordSave();
          if (returnBool == true) {
            if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
              ref{{ TableName }}_Edit.value.hideDialog();
            }
            if (this.iShowList != null)
              {{~ if IsKeyFieldNumeric ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFieldCamel }}.toString());
              {{~ else ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFieldCamel }});
              {{~ end ~}}
          }
          {{~ end ~}}
          break;
        case '确认修改':
          returnBool = await this.UpdateRecordSave();
          strInfo = returnBool ? '修改成功!' : '修改不成功!';
          strInfo += '(In {{ TableName }}_EditAi.btnSubmit_Click)';
          alert(strInfo);
          if (returnBool == true) {
            if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
              ref{{ TableName }}_Edit.value.hideDialog();
            }
            if (this.iShowList != null)
              {{~ if IsMultiKey ~}}
              {{~ if KeyFields.size > 0 ~}}
              // 🔥 多关键字段：使用第一个关键字段的值
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFields[0].FieldNameCamel }});
              {{~ else ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, '');
              {{~ end ~}}
              {{~ else ~}}
              {{~ if IsKeyFieldNumeric ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFieldCamel }}.toString());
              {{~ else ~}}
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId.{{ KeyFieldCamel }});
              {{~ end ~}}
              {{~ end ~}}
          }
          break;
        default:
          strMsg = Format(
            'strCommandText:{0}在switch中没有处理!(In btnSubmit_Click())',
            strCommandText,
          );
          console.error(strMsg);
          alert(strMsg);
          break;
      }
    } catch (e) {
      const strMsg = Format(
        '(errid: WiTsCs0033)在保存记录时({3})时出错!请联系管理员!{0}.(in {1}.{2})',
        e,
        this.className,
        strThisFuncName,
        strCommandText,
      );
      console.error(strMsg);
      alert(strMsg);
    }
  }

