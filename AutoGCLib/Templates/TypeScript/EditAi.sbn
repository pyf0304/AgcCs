      );
      console.error(strMsg);
      alert(strMsg);
      throw strMsg;
    }
    try {
      {{ TableName }}_CheckPropertyNew(obj{{ TableName }}EN);
    } catch (e) {
      const strMsg = Format(
        '检查数据不成功,{0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      throw strMsg;
    }
    try {
      const bolIsExistCond = await this.CheckUniCond4Add(obj{{ TableName }}EN);
      if (bolIsExistCond == false) {
        return '';
      }
      const responseKeyId = await {{ TableName }}_AddNewRecordWithMaxIdAsync(obj{{ TableName }}EN);
      const returnKeyId: string = responseKeyId;
      if (IsNullOrEmpty(returnKeyId) == false) {
