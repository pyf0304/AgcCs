  /** 显示指定记录的数据 */
  public async ShowData(key: {{ TableName }}Key) {
    const strThisFuncName = this.ShowData.name;
    let obj{{ TableName }}EN = new cls{{ TableName }}EN();
    try {
      const returnBool = await {{ TableName }}_IsExistAsync(key);
       if (returnBool == false) {
        const strInfo = Format('关键字:[{0}] 的记录不存在!', key.{{ KeyFieldCamel }});
        alert(strInfo);
        return;
      }
    } catch (e) {
      const strMsg = Format(
        '检查相应关键字的记录存在不成功, {0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
    }
    try {
      const obj{{ TableName }}ENConst = await {{ TableName }}_GetObjByKeyAsync(key);
      if (obj{{ TableName }}ENConst == null) {
        const strMsg = Format(
          '根据关键字获取相应的记录的对象为空.(in {0}.{1})',
          this.constructor.name,
          strThisFuncName,
        );
        console.error(strMsg);
        alert(strMsg);
        return;
      }
      obj{{ TableName }}EN = obj{{ TableName }}ENConst;
    } catch (e) {
      const strMsg = Format(
        '根据关键字获取相应的记录的对象不成功,{0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
    }
    ref{{ TableName }}_Edit.value.ShowDataFrom{{ TableName }}Obj(obj{{ TableName }}EN);
  }

  /** 修改记录（显示数据） */
  public async UpdateRecord(key: {{ TableName }}Key): Promise<boolean> {
    const strThisFuncName = this.UpdateRecord.name;
    this.keyId = key;
    try {
      const obj{{ TableName }}EN = await {{ TableName }}_GetObjByKeyAsync(key);
      if (obj{{ TableName }}EN == null) {
        const strMsg = Format(
          '根据关键字获取相应的记录的对象为空.(in {0}.{1})',
          this.className,
          strThisFuncName,
        );
        console.error(strMsg);
        alert(strMsg);
        return false;
      }
      await ref{{ TableName }}_Edit.value.ShowDataFrom{{ TableName }}Obj(obj{{ TableName }}EN);
      return true;
    } catch (e) {
      const strMsg = Format(
        '修改记录时，显示信息出错,{0}.(in {1}.{2})',
        e,
        this.className,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
  }

  
