  public async AddNewRecordWithMaxIdSave(): Promise<string> {
    const strThisFuncName = this.AddNewRecordWithMaxIdSave.name;
    let obj{{ TableName }}EN;
    try {
      obj{{ TableName }}EN = await ref{{ TableName }}_Edit.value.GetEditData{{ TableName }}Obj();
    } catch (e) {
      const strMsg = Format(
        '从界面获取数据不成功,{0}.(in {1}.{2})',
