      if (bolIsExistCond == false) {
        return false;
      }
      const returnBool = await {{ TableName }}_UpdateRecordAsync(obj{{ TableName }}EN);
      if (returnBool == true) {
        {{ TableName }}_ReFreshCache();
        {{ TableName }}_DeleteKeyIdCache(this.keyId);
      }
      return returnBool;
    } catch (e) {
