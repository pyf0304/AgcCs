  /** 确认提交按钮点击事件 */
  public async btnSubmit_Click() {
    const strThisFuncName = this.btnSubmit_Click.name;
    const strCommandText: string = this.btnSubmit{{ TableName }};
    try {
      let returnBool = false;
      let returnKeyId = '';
      let strInfo = '';
      let strMsg = '';
      switch (strCommandText) {
        case '添加':
          this.btnSubmit{{ TableName }} = '确认添加';
          this.btnCancel{{ TableName }} = '取消添加';
          await this.AddNewRecord();
          break;
        case '确认添加':
          if (['02', '03', '06'].indexOf(cls{{ TableName }}EN._PrimaryTypeId) > -1) {
            returnKeyId = await this.AddNewRecordWithMaxIdSave();
            if (IsNullOrEmpty(returnKeyId) == false) {
              if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01)
                this.HideDialog_{{ TableName }}();
              if (this.iShowList != null)
                this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, returnKeyId);
            }
          } else {
            returnBool = await this.AddNewRecordSave();
            if (returnBool == true) {
              if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
                ref{{ TableName }}_Edit.value.hideDialog();
              }
              if (this.iShowList != null)
                this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId);
            }
          }
          break;
        case '确认修改':
          returnBool = await this.UpdateRecordSave();
          strInfo = returnBool ? '修改成功!' : '修改不成功!';
          strInfo += '(In {{ TableName }}_EditAi.btnSubmit_Click)';
          alert(strInfo);
          if (returnBool == true) {
            if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
              ref{{ TableName }}_Edit.value.hideDialog();
            }
            if (this.iShowList != null)
              this.iShowList.BindGvCache(cls{{ TableName }}EN._CurrTabName, this.keyId);
          }
          break;
        default:
          strMsg = Format(
            'strCommandText:{0}在switch中没有处理!(In btnSubmit_Click())',
            strCommandText,
          );
          console.error(strMsg);
          alert(strMsg);
          break;
      }
    } catch (e) {
      const strMsg = Format(
        '(errid: WiTsCs0033)在保存记录时({3})时出错!请联系管理员!{0}.(in {1}.{2})',
        e,
        this.className,
        strThisFuncName,
        strCommandText,
      );
      console.error(strMsg);
      alert(strMsg);
    }
  }

