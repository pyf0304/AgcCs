  /** 显示对话框 */
  public async ShowDialog_{{ TableName }}(strOp: string): Promise<boolean> {
    const strThisFuncName = this.ShowDialog_{{ TableName }}.name;
    if ({{ TableName }}_EditAi.strPageDispModeId == enumPageDispMode.PopupBox_01) {
      if (ref{{ TableName }}_Edit.value == null) {
        const strMsg = Format(
          '当前编辑区的EditObj为空，请检查！(in {0}.{1})',
          this.className,
          strThisFuncName,
        );
        console.error(strMsg);
        alert(strMsg);
        return false;
      }
      await ref{{ TableName }}_Edit.value.showDialog(this);
    }
    if (strOp === 'Add' || strOp === 'AddWithMaxId') {
      this.btnSubmit{{ TableName }} = '确认添加';
      this.btnCancel{{ TableName }} = '取消添加';
    } else if (strOp === 'Update') {
      this.btnSubmit{{ TableName }} = '确认修改';
      this.btnCancel{{ TableName }} = '取消修改';
    }
    return true;
  }

  /** 添加新记录 */
  public async btnAddNewRecord_Click() {
    const strThisFuncName = this.btnAddNewRecord_Click.name;
    try {
      this.opType = 'Add';
      const bolIsSuccess = await this.ShowDialog_{{ TableName }}(this.opType);
      if (bolIsSuccess == false) return;
      if (['02', '03', '06'].indexOf(cls{{ TableName }}EN._PrimaryTypeId) > -1) {
        await this.AddNewRecordWithMaxId();
      } else {
        await this.AddNewRecord();
      }
    } catch (e) {
      const strMsg = Format(
        '添加新记录初始化不成功,{0}.(in {1}.{2})',
        e,
        this.className,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
    }
  }

