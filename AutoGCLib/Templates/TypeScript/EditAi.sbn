  /** 添加新记录,保存函数
   * (AutoGCLib.Vue_ViewScript_EditAi_TS4TypeScript:Gen_Vue_Ts_AddNewRecordSave)
   **/
  public async AddNewRecordSave(): Promise<boolean> {
    const strThisFuncName = this.AddNewRecordSave.name;
    let obj{{ TableName }}EN;
    try {
      obj{{ TableName }}EN = await ref{{ TableName }}_Edit.value.GetEditData{{ TableName }}Obj();
    } catch (e) {
      const strMsg = Format(
        '从界面获取数据不成功,{0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
    try {
      {{ TableName }}_CheckPropertyNew(obj{{ TableName }}EN);
    } catch (e) {
      const strMsg = Format(
        '检查数据不成功,{0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
    try {
      {{~ if NeedUniCheck ~}}
          //检查唯一性条件
          const bolIsExistCond = await this.CheckUniCond4Add(obj{{ TableName }}EN);
          if (bolIsExistCond == false) {
            return false;
          }
      {{~ end ~}}
      let returnBool = false;
      {{~ if PrimaryTypeId == "02" ~}}
          // Identity_02: 整数自增，直接调用 AddNewRecordAsync
          returnBool = await {{ TableName }}_AddNewRecordAsync(obj{{ TableName }}EN);
          {{~ else if PrimaryTypeId == "03" ~}}
          // StringAutoAddPrimaryKey_03: 字符串自增，需要获取返回的 KeyId
          const returnKeyId = await {{ TableName }}_AddNewRecordWithMaxIdAsync(obj{{ TableName }}EN);
          if (IsNullOrEmpty(returnKeyId) == false) {
            // 🔥 赋值为对象格式
            this.keyId = { {{ KeyFieldCamel }}: returnKeyId };
            returnBool = true;
          }
          {{~ else if PrimaryTypeId == "06" ~}}
          // StringAutoAddPrimaryKeyWithPrefix_06: 字符串自增带前缀
          const returnKeyId = await {{ TableName }}_AddNewRecordWithMaxIdAsync(obj{{ TableName }}EN);
          if (IsNullOrEmpty(returnKeyId) == false) {
            // 🔥 赋值为对象格式
            this.keyId = { {{ KeyFieldCamel }}: returnKeyId };
            returnBool = true;
          }
      {{~ else ~}}
      // 其他类型：先检查关键字是否存在
      {{~ if NeedCheckKeyExist ~}}
      {{~ if IsMultiKey ~}}
      // 🔥 多关键字段：传递对象
      const bolIsExist = await {{ TableName }}_IsExistAsync({
        {{~ for keyField in KeyFields ~}}
        {{ keyField.FieldNameCamel }}: obj{{ TableName }}EN.{{ keyField.FieldNameCamel }}{{ if !for.last }},{{ end }}
        {{~ end ~}}
      });
      {{~ else ~}}
      // 🔥 单关键字段：传递值
      const bolIsExist = await {{ TableName }}_IsExistAsync(obj{{ TableName }}EN.{{ KeyFieldCamel }});
      {{~ end ~}}
      if (bolIsExist == true) {
        {{~ if IsMultiKey ~}}
        const strMsg = Format('添加记录时,关键字已经存在!');
        {{~ else ~}}
        const strMsg = Format('添加记录时,关键字：{0}已经存在!', obj{{ TableName }}EN.{{ KeyFieldCamel }});
        {{~ end ~}}
        console.error(strMsg);
        alert(strMsg);
        return false;
      }
      {{~ end ~}}
      returnBool = await {{ TableName }}_AddNewRecordAsync(obj{{ TableName }}EN);
      {{~ end ~}}
      if (returnBool == true) {
          {{~ if NeedRefreshCache ~}}
        {{~ if HasCacheClassifyField ~}}
        {{ TableName }}_ReFreshCache(obj{{ TableName }}EN.{{ CacheClassifyFieldCamel }});
          {{ TableName }}_DeleteKeyIdCache(obj{{ TableName }}EN.{{ CacheClassifyFieldCamel }}, this.keyId);
      
        {{~ else ~}}
        {{ TableName }}_ReFreshCache();
           {{ TableName }}_DeleteKeyIdCache(this.keyId);
     
        {{~ end ~}}
        {{~ else ~}}
        // {{ TableName }}_ReFreshCache(); // 🔥 当前表未使用 localStorage/sessionStorage 缓存，无需刷新
        {{~ end ~}}

        const strInfo = `添加[{{ TableCnName }}({{ TableName }})]记录成功!`;
        if (this.isShowMsg == true) alert(strInfo);
      } else {
        const strInfo = `添加[{{ TableCnName }}({{ TableName }})]记录不成功!`;
        alert(strInfo);
      }
      return returnBool;
    } catch (e) {
      const strMsg = Format(
        '添加记录不成功,{0}.(in {1}.{2})',
        e,
        this.constructor.name,
        strThisFuncName,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
  }
    

{{~ if NeedUniCheck ~}}
  /** 为添加记录检查唯一性条件 */
  public async CheckUniCond4Add(obj{{ TableName }}EN: cls{{ TableName }}EN): Promise<boolean> {
    const strUniquenessCondition = {{ TableName }}_GetUniCondStr(obj{{ TableName }}EN);
    const bolIsExistCondition = await {{ TableName }}_IsExistRecordAsync(strUniquenessCondition);
    if (bolIsExistCondition == true) {
      const strMsg = Format(
        '不能满足唯一性条件。满足条件：{0}的记录已经存在!',
        strUniquenessCondition,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
    return true;
  }

  /** 为修改记录检查唯一性条件 */
  public async CheckUniCond4Update(obj{{ TableName }}EN: cls{{ TableName }}EN): Promise<boolean> {
    const strUniquenessCondition = {{ TableName }}_GetUniCondStr4Update(obj{{ TableName }}EN);
    const bolIsExistCondition = await {{ TableName }}_IsExistRecordAsync(strUniquenessCondition);
    if (bolIsExistCondition == true) {
      const strMsg = Format(
        '不能满足唯一性条件。满足条件：{0}的记录已经存在!',
        strUniquenessCondition,
      );
      console.error(strMsg);
      alert(strMsg);
      return false;
    }
    return true;
  }
