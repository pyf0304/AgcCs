type {{ table_name }}_WholeCacheItem = {
  list: Array<cls{{ table_name }}EN>;
  index: Map<string, cls{{ table_name }}EN>;
};

const _{{ table_name }}ObjectCache = new Map<string, Map<string, cls{{ table_name }}EN>>();
const _{{ table_name }}WholeCache = new Map<string, {{ table_name }}_WholeCacheItem>();
const _{{ table_name }}BatchInFlight = new Map<string, Promise<Array<cls{{ table_name }}EN>>>();
const _{{ table_name }}CacheStats = {
  objectHit: 0,
  batchHit: 0,
  wholeHit: 0,
  webHit: 0,
};
const {{ table_name }}_DefaultCacheKey = `${ {{ constructor_name }} }_DEFAULT`;

function {{ table_name }}_GetCacheBucketKey(strCacheKey = ''): string {
  if (IsNullOrEmpty(strCacheKey) == true) return {{ table_name }}_DefaultCacheKey;
  return strCacheKey;
}

function {{ table_name }}_GetPrjObjectMap(
  strCacheKey = '',
  bolCreate = true,
): Map<string, cls{{ table_name }}EN> | null {
  const strBucketKey = {{ table_name }}_GetCacheBucketKey(strCacheKey);
  let objMap = _{{ table_name }}ObjectCache.get(strBucketKey);
  if (objMap == null && bolCreate == true) {
    objMap = new Map<string, cls{{ table_name }}EN>();
    _{{ table_name }}ObjectCache.set(strBucketKey, objMap);
  }
  return objMap ?? null;

}

function {{ table_name }}_NormalizeAndBuildIndex(arrObjLst: Array<cls{{ table_name }}EN>) {
  const arrNormalized = {{ table_name }}_GetObjLstByJSONObjLst(arrObjLst);
  const objIndex = new Map<string, cls{{ table_name }}EN>();
  for (const objItem of arrNormalized) {
     {{~ if is_multi_key ~}}
        const strKey = {{ table_name }}_JoinByKeyLst(objItem);
        objIndex.set(strKey, objItem);
     {{~ else ~}}
        objIndex.set(objItem.{{ key_field_camel }}.toString(), objItem);
     {{~ end ~}}
  }
  return {
    list: arrNormalized,
    index: objIndex,
  };
}

function {{ table_name }}_AddObjCacheCore(strCacheKey = '',
  obj{{ table_name }}: cls{{ table_name }}EN
): void {
  const objMap = {{ table_name }}_GetPrjObjectMap(strCacheKey, true);
     {{~ if is_multi_key ~}}
        const strKey = {{ table_name }}_JoinByKeyLst(obj{{ table_name }});
        objMap?.set(strKey, obj{{ table_name }});
     {{~ else ~}}
        objMap?.set(obj{{ table_name }}.{{ key_field_camel }}.toString(), obj{{ table_name }});
     {{~ end ~}}
  
}

function {{ table_name }}_RemoveObjCacheCore(  strCacheKey = '', key: {{table_name}}Key): void {
  const objMap = {{ table_name }}_GetPrjObjectMap(strCacheKey, false);
    {{~ if is_multi_key ~}}
        const strKey = {{table_name}}_JoinByKeys(key);
        objMap?.delete(strKey);
    {{~ else ~}}
        objMap?.delete(key.{{ key_field_camel }}.toString());
    {{~ end ~}}
}

function {{ table_name }}_UpdateWholeCacheListByObj(strCacheKey = '',
  obj{{ table_name }}: cls{{ table_name }}EN,
): void {
  const objWholeCache = _{{ table_name }}WholeCache.get(strCacheKey);
  if (objWholeCache == null) return;
    {{~ if is_multi_key ~}}
       const strKey = {{ table_name }}_JoinByKeyLst(obj{{ table_name }});
       objWholeCache.index.set(strKey, obj{{ table_name }});
       const intIndex = objWholeCache.list.findIndex(
            (x) => {{ table_name }}_JoinByKeyLst(x) == strKey,
       );
    {{~ else ~}}
       objWholeCache.index.set(obj{{ table_name }}.{{ key_field_camel }}.toString(), obj{{ table_name }});
       const intIndex = objWholeCache.list.findIndex((x) => x.{{ key_field_camel }} == obj{{ table_name }}.{{ key_field_camel }});
    {{~ end ~}}


  if (intIndex >= 0) {
    objWholeCache.list[intIndex] = obj{{ table_name }};
  } else {
    objWholeCache.list.push(obj{{ table_name }});
  }
}

function {{ table_name }}_RemoveFromWholeCache(  strCacheKey = '', key: {{table_name}}Key): void {
  const objWholeCache = _{{ table_name }}WholeCache.get(strCacheKey);
  if (objWholeCache == null) return;
   {{~ if is_multi_key ~}}
        const strKey = {{table_name}}_JoinByKeys(key);
        objWholeCache.index.delete(strKey);
        const intIndex = objWholeCache.list.findIndex(
            (x) => {{table_name}}_JoinByKeyLst(x) == strKey,
        );
   {{~ else ~}}
        objWholeCache.index.delete(key.{{ key_field_camel }}.toString());
        const intIndex = objWholeCache.list.findIndex((x) => x.{{ key_field_camel }} == key.{{ key_field_camel }});
   {{~ end ~}}
   if (intIndex >= 0) objWholeCache.list.splice(intIndex, 1);
}

